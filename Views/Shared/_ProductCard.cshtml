@model UltraPokemon.Models.Product

<!-- Gắn class card-sparkle từ site.css để kích hoạt hiệu ứng vệt sáng lấp lánh khi hover -->
<div class="card card-sparkle h-100 border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="position-relative bg-light text-center p-3">
        <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-card.png" : Model.ImageUrl)"
                 alt="@Model.Name"
                 class="img-fluid rounded-3"
                 style="height: 230px; object-fit: contain;" />
        </a>

        <span class="badge bg-dark position-absolute top-0 start-0 m-2 rounded-pill px-3">
            @Model.ElementType
        </span>
        <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 rounded-pill fw-bold">
            HP @Model.Power
        </span>
    </div>

    <div class="card-body d-flex flex-column bg-white">
        <h6 class="card-title fw-bold mb-1">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">
                @Model.Name
            </a>
        </h6>

        <div class="text-danger fw-bold fs-5 mb-2">@Model.Price.ToString("N0") đ</div>

        <div class="mt-auto">
            @if (Model.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill fw-semibold">
                        <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                    </button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary btn-sm w-100 rounded-pill" disabled>
                    <i class="bi bi-x-circle me-1"></i> Hết hàng
                </button>
            }
        </div>
    </div>
</div>