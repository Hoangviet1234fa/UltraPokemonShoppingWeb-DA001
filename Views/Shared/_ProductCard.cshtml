@model UltraPokemon.Models.Product

@{
    // [ĐÃ FIX] Chuẩn hóa tên hệ nguyên tố sang tiếng Việt đồng bộ trên toàn bộ thẻ bài
    string tenHeViet = (Model.ElementType?.Trim().ToLowerInvariant()) switch
    {
        "fire" or "lửa" => "Lửa",
        "water" or "nước" => "Nước",
        "electric" or "điện" => "Điện",
        "rock" or "đá" => "Đá",
        "grass" or "cỏ" => "Cỏ",
        "psychic" or "tâm linh" => "Tâm linh",
        _ => string.IsNullOrWhiteSpace(Model.ElementType) ? "Phổ thông" : Model.ElementType
    };
}

<div class="card card-sparkle h-100">
    <!-- Thanh thông số phía trên: Hệ nguyên tố & Chỉ số HP -->
    <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
        <span class="badge bg-light text-secondary border fw-medium rounded-1 px-2 py-1">
            Hệ @tenHeViet
        </span>
        <span class="font-mono-stat text-muted small fw-bold">
            HP @Model.Power
        </span>
    </div>

    <!-- Khung hiển thị hình ảnh thẻ bài (sạch, không bị sticker che góc) -->
    <div class="px-3 py-2 text-center">
        <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id" class="d-block bg-light rounded-2 p-3">
            @* Sử dụng ImageHelper.Resolve kèm fallback SVG mặc định *@
            <img src="@ImageHelper.Resolve(Env, Model)"
                 onerror="this.onerror=null;this.src=this.dataset.fallback;"
                 data-fallback="@ImageHelper.Placeholder(Model)"
                 alt="@Model.Name"
                 class="img-fluid"
                 style="height: 215px; object-fit: contain;" />
        </a>
    </div>

    <!-- Thông tin tên thẻ, giá bán, tồn kho và nút thao tác -->
    <div class="card-body d-flex flex-column pt-2 pb-3 px-3">
        <h6 class="card-title fw-bold mb-1 text-truncate">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">
                @Model.Name
            </a>
        </h6>

        <div class="d-flex justify-content-between align-items-baseline mb-3">
            <span class="font-mono-stat text-dark fw-bold fs-6">@Model.Price.ToString("N0") đ</span>
            @if (Model.Stock > 0)
            {
                <span class="font-mono-stat text-success small">Còn @Model.Stock</span>
            }
            else
            {
                <span class="font-mono-stat text-danger small">Hết hàng</span>
            }
        </div>

        <div class="mt-auto d-flex gap-2">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary btn-sm rounded-2 px-3">
                Chi tiết
            </a>

            @if (Model.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="flex-grow-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-dark btn-sm w-100 rounded-2 fw-medium">
                        Thêm vào giỏ
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-light text-muted border btn-sm flex-grow-1 rounded-2" disabled>
                    Hết hàng
                </button>
            }
        </div>
    </div>
</div>