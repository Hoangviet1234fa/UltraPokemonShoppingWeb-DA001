@using System.Text.Json

@{
    // =========================================================================
    // 1. ĐỌC DỮ LIỆU GIỎ HÀNG TỪ SESSION & TÍNH TỔNG SỐ LƯỢNG LÁ BÀI HIỆN CÓ
    // =========================================================================
    int cartCount = 0;

    foreach (var key in Context.Session.Keys)
    {
        if (key.Contains("cart", StringComparison.OrdinalIgnoreCase) ||
            key.Contains("giohang", StringComparison.OrdinalIgnoreCase))
        {
            var json = Context.Session.GetString(key);
            if (string.IsNullOrEmpty(json)) continue;

            try
            {
                using var doc = JsonDocument.Parse(json);
                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    foreach (var item in doc.RootElement.EnumerateArray())
                    {
                        if (item.TryGetProperty("Quantity", out var q) ||
                            item.TryGetProperty("quantity", out q) ||
                            item.TryGetProperty("SoLuong", out q))
                        {
                            cartCount += q.GetInt32();
                        }
                    }
                }
                else if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    foreach (var prop in doc.RootElement.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == JsonValueKind.Number)
                        {
                            cartCount += prop.Value.GetInt32();
                        }
                    }
                }
                if (cartCount > 0) break;
            }
            catch { }
        }
    }

    // Xác định Controller hiện tại để tự động làm nổi bật mục menu đang truy cập
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool isHomeActive = currentController.Equals("Home", StringComparison.OrdinalIgnoreCase);
    bool isProductActive = currentController.Equals("Product", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UltraPokémon</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- 1. VIDEO NỀN CỐ ĐỊNH -->
    <div class="video-background-container">
        <video autoplay muted loop playsinline class="bg-video">
            <source src="~/videos/183279-870457579.mp4" type="video/mp4" />
        </video>
        <div class="video-overlay"></div>
    </div>

    <!-- 2. ÁNH SÁNG THEO CON TRỎ CHUỘT -->
    <div id="mouseGlow" class="mouse-glow d-none d-md-block"></div>

    <!-- 3. KHUNG NỘI DUNG CHÍNH -->
    <div class="main-content-wrapper d-flex flex-column min-vh-100">

        <!-- THANH ĐIỀU HƯỚNG (NAVBAR) -->
        <header class="sticky-top up-header">
            <nav class="navbar navbar-expand-lg navbar-dark py-0">
                <div class="container up-nav-inner">

                    <!-- Logo vector & thương hiệu UltraPokémon -->
                    <a class="navbar-brand up-brand d-flex align-items-center gap-2.5 py-2 m-0"
                       asp-controller="Home" asp-action="Index">
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                            <rect width="28" height="28" rx="6" fill="#FACC15" />
                            <path d="M5 14H10.5M17.5 14H23" stroke="#0F172A" stroke-width="2.2" stroke-linecap="round" />
                            <circle cx="14" cy="14" r="8.5" stroke="#0F172A" stroke-width="2.2" />
                            <circle cx="14" cy="14" r="3" fill="#0F172A" />
                        </svg>
                        <span class="up-brand-text">Ultra<span>Pokémon</span></span>
                    </a>

                    <button class="navbar-toggler border-0 shadow-none p-2" type="button"
                            data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-label="Mở menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">

                        <!-- Danh mục điều hướng chính -->
                        <ul class="navbar-nav ms-lg-4 me-auto align-items-lg-center gap-lg-1">
                            <li class="nav-item">
                                <a class="nav-link up-nav-link @(isHomeActive ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link up-nav-link @(isProductActive ? "active" : "")"
                                   asp-controller="Product" asp-action="Index">Kho thẻ bài</a>
                            </li>
                            <!-- Cuộn trực tiếp xuống khối Thông tin & Liên hệ cửa hàng -->
                            <li class="nav-item">
                                <a class="nav-link up-nav-link" href="#aboutShopSection">Thông tin &amp; Liên hệ</a>
                            </li>

                            @* MENU QUẢN TRỊ DÀNH CHO ADMIN & STAFF *@
                            @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link up-nav-link up-admin-trigger dropdown-toggle"
                                       href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Quản trị
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark up-dropdown shadow-lg">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index">
                                                    <i class="bi bi-bar-chart-line me-2 text-secondary"></i>Báo cáo doanh thu
                                                </a>
                                            </li>
                                        }
                                        <li>
                                            <a class="dropdown-item" asp-controller="Product" asp-action="Index">
                                                <i class="bi bi-collection me-2 text-secondary"></i>Danh mục thẻ bài
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="AdminOrders" asp-action="Index">
                                                <i class="bi bi-receipt me-2 text-secondary"></i>Đơn đặt hàng
                                            </a>
                                        </li>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a class="dropdown-item" asp-controller="AdminAccounts" asp-action="Index">
                                                    <i class="bi bi-people me-2 text-secondary"></i>Tài khoản hệ thống
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>

                        <!-- Thanh tìm kiếm nhanh trên header -->
                        <form asp-controller="Product" asp-action="Index" method="get"
                              class="up-nav-search d-none d-xl-flex align-items-center me-3">
                            <i class="bi bi-search up-search-icon"></i>
                            <input type="search"
                                   name="searchString"
                                   value="@Context.Request.Query["searchString"]"
                                   class="up-search-input"
                                   placeholder="Tìm nhanh thẻ bài..."
                                   aria-label="Tìm nhanh thẻ bài" />
                        </form>

                        <!-- GIỎ HÀNG & TÀI KHOẢN -->
                        <div class="d-flex align-items-center gap-2 py-2 py-lg-0">
                            <a asp-controller="Cart" asp-action="Index" class="up-cart-btn">
                                <i class="bi bi-bag"></i>
                                <span>Giỏ hàng</span>
                                <span class="up-cart-count @(cartCount > 0 ? "has-items" : "")">@cartCount</span>
                            </a>

                            <span class="up-nav-divider d-none d-lg-inline-block"></span>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <div class="dropdown">
                                    <button class="up-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <span class="up-user-dot"></span>
                                        <span class="text-truncate" style="max-width: 150px;">@User.Identity.Name</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark up-dropdown shadow-lg">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">
                                                <i class="bi bi-box-seam me-2 text-secondary"></i>Đơn hàng của tôi
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-2">
                                                    Đăng xuất
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="up-login-link">Đăng nhập</a>
                                <a asp-controller="Account" asp-action="Register" class="up-register-btn">Đăng ký</a>
                            }
                        </div>

                    </div>
                </div>
            </nav>
        </header>

        <!-- NỘI DUNG TỪNG TRANG -->
        <main role="main" class="container my-4 flex-grow-1">
            @RenderBody()
        </main>

        <!-- =================================================================
             4. KHỐI THÔNG TIN CỬA HÀNG & LIÊN HỆ TRỰC TIẾP (ĐẦY ĐỦ NỘI DUNG)
             ================================================================= -->
        <section id="aboutShopSection" class="container mb-4 mt-2">
            <div class="glass-bar text-light border rounded-3 p-4 p-lg-5 shadow-lg">
                <div class="row g-4 g-lg-5 align-items-start">

                    <!-- Cột trái: Giới thiệu cửa hàng & Quy chuẩn bảo quản -->
                    <div class="col-lg-7">
                        <div class="text-uppercase text-warning fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.08em;">
                            Thông tin cửa hàng &amp; Quy chuẩn dịch vụ
                        </div>
                        <h4 class="fw-bold mb-3">UltraPokémon Card Store — Chuyên trang sưu tầm thẻ bài Pokémon TCG</h4>

                        <p class="text-light text-opacity-75 small mb-3" style="line-height: 1.7;">
                            UltraPokémon là hệ thống phân phối và giao dịch thẻ bài Pokémon TCG nguyên bản (ấn bản Quốc tế và Nhật Bản), phục vụ người chơi thi đấu lẫn giới sưu tầm. Danh mục sản phẩm bao gồm đầy đủ các dòng thẻ thuộc 6 hệ nguyên tố (Fire, Water, Electric, Rock, Grass, Psychic) từ phiên bản cơ bản đến các lá bài hiếm như GX, V, VMAX và Secret Rare.
                        </p>

                        <p class="text-light text-opacity-75 small mb-4" style="line-height: 1.7;">
                            Tất cả thẻ bài trước khi niêm yết đều trải qua bước kiểm tra độ phẳng, góc cạnh và bề mặt in theo thang đánh giá Mint / Near Mint. Khi xuất kho, mỗi lá bài được lồng sẵn vào bọc bảo vệ chống trầy (Sleeve), kẹp khung cứng (Toploader) và đóng hộp chống va đập 3 lớp.
                        </p>

                        <!-- 3 chỉ số cam kết -->
                        <div class="row g-3 pt-1">
                            <div class="col-4">
                                <div class="border border-secondary border-opacity-25 rounded-2 p-3 bg-dark bg-opacity-50">
                                    <div class="font-mono-stat fw-bold text-warning fs-5">100%</div>
                                    <div class="text-secondary small">Thẻ bài chính hãng</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border border-secondary border-opacity-25 rounded-2 p-3 bg-dark bg-opacity-50">
                                    <div class="font-mono-stat fw-bold text-light fs-5">6 Hệ</div>
                                    <div class="text-secondary small">Phân loại đầy đủ</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border border-secondary border-opacity-25 rounded-2 p-3 bg-dark bg-opacity-50">
                                    <div class="font-mono-stat fw-bold text-light fs-5">24h</div>
                                    <div class="text-secondary small">Xử lý &amp; đóng gói</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cột phải: Thông tin liên hệ, địa chỉ & chính sách hỗ trợ -->
                    <div class="col-lg-5">
                        <div class="border border-secondary border-opacity-25 rounded-3 p-4 bg-dark bg-opacity-50 h-100">
                            <h6 class="fw-bold text-uppercase text-warning mb-3" style="font-size: 0.8rem; letter-spacing: 0.06em;">
                                Liên hệ &amp; Hỗ trợ khách hàng
                            </h6>

                            <ul class="list-unstyled d-flex flex-column gap-3 small mb-4">
                                <li class="d-flex align-items-start gap-3">
                                    <i class="bi bi-geo-alt text-warning mt-1"></i>
                                    <div>
                                        <div class="text-secondary">Địa chỉ giao dịch trực tiếp</div>
                                        <div class="text-light">127/199/99/22/44 Côn Đảo</div>
                                    </div>
                                </li>
                                <li class="d-flex align-items-start gap-3">
                                    <i class="bi bi-telephone text-warning mt-1"></i>
                                    <div>
                                        <div class="text-secondary">Hotline &amp; Zalo tư vấn</div>
                                        <div class="text-light font-mono-stat">0906.731.188</div>
                                    </div>
                                </li>
                                <li class="d-flex align-items-start gap-3">
                                    <i class="bi bi-envelope text-warning mt-1"></i>
                                    <div>
                                        <div class="text-secondary">Email chăm sóc khách hàng</div>
                                        <div class="text-light font-mono-stat">cskh@ultrapokemon.vn</div>
                                    </div>
                                </li>
                                <li class="d-flex align-items-start gap-3">
                                    <i class="bi bi-clock text-warning mt-1"></i>
                                    <div>
                                        <div class="text-secondary">Thời gian làm việc</div>
                                        <div class="text-light">08:00 – 22:20 (Thứ 2 – Chủ Nhật)</div>
                                    </div>
                                </li>
                            </ul>

                            <div class="border-top border-secondary border-opacity-25 pt-3 small text-secondary" style="line-height: 1.6;">
                                <strong class="text-light">Chính sách giao nhận:</strong> Hỗ trợ đồng kiểm ngoại quan khi nhận hàng (COD) và đổi trả miễn phí trong 7 ngày nếu lá bài không đúng tình trạng mô tả.
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 5. FOOTER -->
        <footer class="footer glass-bar text-secondary py-3 mt-auto border-top">
            <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div>
                    <span class="text-light fw-semibold">UltraPokémon Card Store</span> &mdash; Hệ thống phân phối thẻ bài Pokémon TCG chính hãng
                </div>
                <div>
                    &copy; 2026 UltraPokémon &bull; Đồ án Lập trình Web ASP.NET Core MVC
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const mouseGlow = document.getElementById("mouseGlow");
                if (!mouseGlow) return;

                document.addEventListener("mousemove", function (e) {
                    mouseGlow.style.left = e.clientX + "px";
                    mouseGlow.style.top = e.clientY + "px";
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- =====================================================================
         CSS NỘI BỘ CHO THANH ĐIỀU HƯỚNG (NAVBAR)
         ===================================================================== -->
    <style>
            .up-header {
                background: rgba(11, 17, 32, 0.88);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(255, 255, 255, 0.09);
                box-shadow: 0 4px 24px rgba(0, 0, 0, 0.28);
                z-index: 1030;
            }

            .up-nav-inner {
                min-height: 60px;
            }

            .up-brand-text {
                font-weight: 700;
                font-size: 1.12rem;
                letter-spacing: -0.02em;
                color: #f8fafc;
            }

                .up-brand-text span {
                    color: #facc15;
                }

            .up-nav-link {
                position: relative;
                color: #94a3b8 !important;
                font-size: 0.88rem;
                font-weight: 500;
                padding: 1.1rem 0.85rem !important;
                transition: color 0.15s ease;
            }

                .up-nav-link:hover {
                    color: #f8fafc !important;
                }

                .up-nav-link.active {
                    color: #ffffff !important;
                    font-weight: 600;
                }

                    .up-nav-link.active::after {
                        content: "";
                        position: absolute;
                        left: 0.85rem;
                        right: 0.85rem;
                        bottom: 0;
                        height: 2px;
                        background-color: #facc15;
                        border-radius: 2px 2px 0 0;
                    }

            .up-admin-trigger {
                color: #fbbf24 !important;
            }

            .up-nav-search {
                position: relative;
                width: 220px;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 6px;
                padding: 0 10px;
                height: 34px;
                transition: border-color 0.15s ease, background-color 0.15s ease, width 0.2s ease;
            }

                .up-nav-search:focus-within {
                    width: 260px;
                    background: rgba(255, 255, 255, 0.08);
                    border-color: rgba(250, 204, 21, 0.5);
                }

            .up-search-icon {
                color: #64748b;
                font-size: 0.82rem;
                margin-right: 8px;
            }

            .up-search-input {
                width: 100%;
                background: transparent;
                border: 0;
                outline: none;
                color: #f8fafc;
                font-size: 0.82rem;
            }

                .up-search-input::placeholder {
                    color: #64748b;
                }

            .up-cart-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                height: 34px;
                padding: 0 12px;
                border-radius: 6px;
                font-size: 0.84rem;
                font-weight: 500;
                color: #e2e8f0;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.12);
                text-decoration: none;
                transition: all 0.15s ease;
            }

                .up-cart-btn:hover {
                    background: rgba(255, 255, 255, 0.09);
                    border-color: rgba(255, 255, 255, 0.24);
                    color: #ffffff;
                }

            .up-cart-count {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 20px;
                height: 20px;
                padding: 0 5px;
                border-radius: 4px;
                font-size: 0.74rem;
                font-weight: 700;
                font-variant-numeric: tabular-nums;
                background: rgba(255, 255, 255, 0.08);
                color: #94a3b8;
            }

                .up-cart-count.has-items {
                    background: #facc15;
                    color: #0f172a;
                }

            .up-nav-divider {
                width: 1px;
                height: 20px;
                background: rgba(255, 255, 255, 0.12);
                margin: 0 4px;
            }

            .up-login-link {
                color: #cbd5e1;
                font-size: 0.84rem;
                font-weight: 500;
                padding: 0 10px;
                text-decoration: none;
                transition: color 0.15s ease;
            }

                .up-login-link:hover {
                    color: #ffffff;
                }

            .up-register-btn {
                display: inline-flex;
                align-items: center;
                height: 34px;
                padding: 0 14px;
                border-radius: 6px;
                font-size: 0.84rem;
                font-weight: 600;
                background: #facc15;
                color: #0f172a;
                text-decoration: none;
                transition: background-color 0.15s ease;
            }

                .up-register-btn:hover {
                    background: #fde047;
                    color: #0f172a;
                }

            .up-user-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                height: 34px;
                padding: 0 12px;
                border-radius: 6px;
                font-size: 0.84rem;
                font-weight: 500;
                color: #f8fafc;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.12);
            }

            .up-user-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #22c55e;
            }

            .up-dropdown {
                background-color: #0f172a;
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 8px;
                padding: 6px;
                margin-top: 8px !important;
            }

                .up-dropdown .dropdown-item {
                    font-size: 0.84rem;
                    color: #cbd5e1;
                    border-radius: 5px;
                    padding: 7px 12px;
                }

                    .up-dropdown .dropdown-item:hover {
                        background-color: rgba(255, 255, 255, 0.07);
                        color: #ffffff;
                    }

                .up-dropdown .dropdown-divider {
                    border-color: rgba(255, 255, 255, 0.08);
                    margin: 6px 0;
                }
    </style>
</body>
</html>