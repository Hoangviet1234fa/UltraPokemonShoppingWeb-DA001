@{
    // Lấy giá trị chuỗi tìm kiếm hiện tại từ thanh địa chỉ URL để giữ lại từ khóa trên ô input khi chuyển trang
    var currentSearch = Context.Request.Query["searchString"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ultra Pokemon</title>

    <!-- Nhúng thư viện CSS Bootstrap 5.3.3 từ CDN và file CSS tùy chỉnh của dự án -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
 
    <!-- 1. VIDEO NỀN TOÀN MÀN HÌNH (BACKGROUND VIDEO)  -->

    <div class="video-background-container">
        <video autoplay muted loop playsinline class="bg-video">
            <source src="~/videos/bg-video.mp4" type="video/mp4" />
            Trình duyệt của bạn không hỗ trợ thẻ video.
        </video>
        <div class="video-overlay"></div>
    </div>

    <!-- 2. HIỆU ỨNG ĐỐM SÁNG DI CHUYỂN THEO CON TRỎ CHUỘT (MOUSE GLOW)   -->
    
    <div class="mouse-glow"></div>

    <!-- 3. KHUNG NỘI DUNG CHÍNH CỦA WEBSITE  -->
 
    <div class="main-content-wrapper">
        <header>
            <!-- Thanh điều hướng (Navbar) cố định phía trên cùng -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <!-- Logo thương hiệu dẫn về Trang chủ -->
                    <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                        <span class="text-primary">ULTRA</span> POKEMON
                    </a>

                    <!-- Nút thu gọn menu khi hiển thị trên màn hình điện thoại / máy tính bảng -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <!-- MENU ĐIỀU HƯỚNG BÊN TRÁI -->
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold text-nowrap" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold text-nowrap" asp-controller="Product" asp-action="Index">Pokemon TCG</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-muted text-nowrap" asp-controller="Home" asp-action="About">Giới thiệu</a>
                            </li>

                            <!-- Chỉ hiển thị mục "Đơn hàng của tôi" khi người dùng đã đăng nhập -->
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-semibold text-nowrap" asp-controller="Cart" asp-action="MyOrders">Đơn hàng của tôi</a>
                                </li>
                            }
                        </ul>

                        <!-- KHU VỰC CÔNG CỤ BÊN PHẢI (TÌM KIẾM, GIỎ HÀNG, TÀI KHOẢN / ADMIN) -->
                        <div class="d-flex align-items-center justify-content-end gap-2 ms-auto">

                            <!-- Form tìm kiếm thẻ bài (Gửi truy vấn GET sang ProductController) -->
                            <form class="d-flex align-items-center me-2" asp-controller="Product" asp-action="Index" method="get">
                                <input class="form-control form-control-lg me-2" type="search" name="searchString"
                                       value="@currentSearch" placeholder="Tìm thẻ bài..." aria-label="Search">
                                <button class="btn btn-outline-secondary btn-lg d-flex align-items-center justify-content-center" type="submit" title="Tìm kiếm">
                                    🔍
                                </button>
                            </form>

                            <!-- Nút mở Giỏ hàng kèm bộ đếm tổng số lượng thẻ bài trong Session -->
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-primary btn-lg fw-semibold px-3 d-inline-flex align-items-center text-nowrap">
                                Giỏ hàng (@UltraPokemon.Helpers.CartSession.Count(Context.Session))
                            </a>

                            <!-- PHÂN QUYỀN HIỂN THỊ THEO TRẠNG THÁI ĐĂNG NHẬP -->
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <!-- NẾU LÀ ADMIN: Hiển thị menu thả xuống (Dropdown) khu vực quản trị -->
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="dropdown ms-1">
                                        <a class="dropdown-toggle btn btn-warning text-dark fw-bold px-3 py-2 text-nowrap" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Quản lý
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="adminMenu">
                                            <li>
                                                <a class="dropdown-item py-2 fw-bold text-primary" asp-controller="AdminDashboard" asp-action="Index">Bảng điều khiển</a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item py-2 fw-semibold" asp-controller="AdminAccounts" asp-action="Index">Quản lý Tài khoản</a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item py-2 fw-semibold" asp-controller="AdminOrders" asp-action="Index">Quản lý Đơn hàng</a>
                                            </li>
                                        </ul>
                                    </div>
                                }

                                <!-- Lời chào hiển thị Email người dùng đang đăng nhập -->
                                <span class="fs-6 text-secondary text-nowrap mx-1">Chào, <b>@User.Identity.Name</b></span>

                                <!-- Form Đăng xuất (Bắt buộc dùng phương thức POST kèm AntiForgeryToken để bảo mật) -->
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-lg text-nowrap">Đăng xuất</button>
                                </form>
                            }
                            else
                            {
                                <!-- NẾU CHƯA ĐĂNG NHẬP: Hiển thị nút Đăng nhập và Đăng ký -->
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg fw-semibold px-3 d-inline-flex align-items-center text-nowrap">
                                    Đăng nhập
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg fw-semibold px-3 d-inline-flex align-items-center text-nowrap">
                                    Đăng ký
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>

   
        <!-- 4. THÂN TRANG CHÍNH & KHU VỰC THÔNG BÁO HỆ THỐNG (TEMPDATA) -->
       
        <div class="container">
            <!-- Banner tiêu đề cửa hàng -->
            <div class="banner text-center py-3 mb-3">
                <h2 class="text-primary fw-bold mb-0">ULTRA POKEMON TCG</h2>
            </div>

            <!-- Hiển thị thông báo thành công / báo lỗi được truyền từ Controller qua TempData -->
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success py-2">@ok</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger py-2">@err</div>
            }

            <!-- Vị trí nạp nội dung của từng trang con (Views) -->
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        
        <!-- 5. CHÂN TRANG (FOOTER)                                            -->
      
        <footer class="footer border-top text-center text-muted py-3 mt-4 bg-light">
            &copy; 2026 - <strong>Ultra Pokemon Store</strong> Đồ Án 001 (Nhóm 07)
        </footer>
    </div>

    
    <!-- 6. THƯ VIỆN JAVASCRIPT & HIỆU ỨNG TƯƠNG TÁC                           -->
   
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script điều khiển đốm sáng di chuyển theo chuột và phóng to khi rê vào nút/thẻ -->
    <script>
            document.addEventListener('DOMContentLoaded', function () {
                const glow = document.querySelector('.mouse-glow');

                if (glow) {
                    window.addEventListener('mousemove', function (e) {
                        const x = e.clientX;
                        const y = e.clientY;

                        // Dịch chuyển tâm đốm sáng khớp với tọa độ con trỏ chuột
                        glow.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
                    });
                }

                // Phóng to kích thước đốm sáng khi di chuột qua các thành phần tương tác
                const interactiveItems = document.querySelectorAll('button, .card, a, input');

                interactiveItems.forEach(item => {
                    item.addEventListener('mouseenter', () => {
                        if (glow) {
                            glow.style.width = '550px';
                            glow.style.height = '550px';
                        }
                    });
                    item.addEventListener('mouseleave', () => {
                        if (glow) {
                            glow.style.width = '400px';
                            glow.style.height = '400px';
                        }
                    });
                });
            });
    </script>

    <!-- Nạp các đoạn Script riêng của từng View con (ví dụ: Chart.js ở trang AdminDashboard) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>