<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ultra Pokemon</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="text-primary">ULTRA</span> POKEMON
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link text-dark fw-bold" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link text-primary fw-bold" asp-controller="Product" asp-action="Index">Pokemon TCG</a></li>
                        <li class="nav-item"><a class="nav-link text-primary" asp-controller="Categories" asp-action="Index">Hệ phái</a></li>
                        <li class="nav-item"><a class="nav-link text-muted" asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                    </ul>

                    <!-- Khu vực Tìm kiếm, Giỏ hàng và Tài khoản nằm ở bên phải -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- Tìm kiếm -->
                        <form class="d-flex align-items-center gap-1 m-0" asp-controller="Product" asp-action="Index" method="get">
                            <input class="form-control form-control-sm" type="search" name="searchString"
                                   placeholder="Tìm thẻ bài..." aria-label="Tìm kiếm"
                                   value="@Context.Request.Query["searchString"]" />
                            <button class="btn btn-sm btn-outline-dark text-nowrap" type="submit">🔍</button>
                        </form>

                        <!-- Giỏ hàng -->
                        <a class="btn btn-sm btn-primary text-nowrap" asp-controller="Cart" asp-action="Index">
                            🛒 (@CartSession.Count(Context.Session))
                        </a>

                        <!-- Phân quyền hiển thị tài khoản -->
                        <ul class="navbar-nav flex-row gap-2 align-items-center mb-0 ms-1">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="btn btn-sm btn-warning text-nowrap fw-bold" asp-controller="AdminAccounts" asp-action="Index">⚙️ Quản lý</a>
                                    </li>
                                }
                                <li class="nav-item text-nowrap">
                                    <span class="small text-secondary">Chào, <b>@User.Identity.Name</b></span>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">Đăng xuất</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="btn btn-sm btn-outline-primary text-nowrap" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-sm btn-primary text-nowrap" asp-controller="Account" asp-action="Register">Đăng ký</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <div class="banner text-center py-3 mb-3">
            <h2 class="text-primary fw-bold mb-0">ULTRA POKEMON TCG</h2>
            <small class="text-muted">Hệ thống quản lý hệ phái &amp; bộ bài Pokemon TCG</small>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success py-2">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger py-2">@err</div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top text-center text-muted py-3 mt-4 bg-light">
        &copy; 2026 - <strong>Ultra Pokemon Store</strong> - Đồ Án 001 (Nhóm 07)
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
<body>
    <!-- 1. VIDEO NỀN (BACKGROUND VIDEO) -->
    <<!-- VIDEO NỀN CỐ ĐỊNH -->
    <div class="video-background-container">
        <video autoplay muted loop playsinline class="bg-video">
            <source src="~/videos/bg-video.mp4" type="video/mp4" />
            Trình duyệt của bạn không hỗ trợ thẻ video.
        </video>
        <div class="video-overlay"></div>
    </div>

    <!-- 2. ĐỐM SÁNG DI CHUYỂN THEO CHUỘT (MOUSE GLOW) -->
    <div class="mouse-glow"></div>

    <!-- 3. NỘI DUNG CHÍNH CỦA TRANG WEB -->
    <div class="main-content-wrapper">
        <header>
            <!-- Thanh Navbar / Menu của bạn ở đây -->
        </header>

        <div class="container">
            @RenderBody()
        </div>

        <footer>
            <!-- Footer của bạn -->
        </footer>
    </div>
    <script>
        const glow = document.querySelector('.mouse-glow');

        // Bắt sự kiện di chuyển chuột trên toàn màn hình
        window.addEventListener('mousemove', (e) => {
            const x = e.clientX;
            const y = e.clientY;

            // Cập nhật vị trí đốm sáng theo tọa độ con trỏ chuột
            glow.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
        });

        // Hiệu ứng phóng to đốm sáng khi rê chuột vào các nút bấm hoặc thẻ sản phẩm (Card)
        const interactiveItems = document.querySelectorAll('button, .card, a, input');

        interactiveItems.forEach(item => {
            item.addEventListener('mouseenter', () => {
                glow.style.width = '550px';
                glow.style.height = '550px';
            });
            item.addEventListener('mouseleave', () => {
                glow.style.width = '400px';
                glow.style.height = '400px';
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const glow = document.querySelector('.mouse-glow');

            if (glow) {
                window.addEventListener('mousemove', function (e) {
                    const x = e.clientX;
                    const y = e.clientY;

                    // Dùng translate để dịch chuyển tâm của đốm sáng khớp hoàn toàn với con trỏ chuột
                    glow.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
                });
            }
        });
    </script>
</body>
</html>