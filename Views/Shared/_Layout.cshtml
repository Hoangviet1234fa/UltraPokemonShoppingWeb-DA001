@using System.Text.Json

@{
   
    // TỰ ĐỘNG QUÉT SESSION ĐỂ TÍNH TỔNG SỐ LƯỢNG LÁ BÀI TRONG GIỎ HÀNG
    // Hoạt động với mọi tên key Session (Cart, CART, GioHang, Cart_email...)
    // và hỗ trợ cả 2 cấu trúc JSON: List<CartItem> lẫn Dictionary<int, int>.
  
    int cartCount = 0;

    foreach (var key in Context.Session.Keys)
    {
        // Tìm bất kỳ Session nào có chữ "cart" hoặc "giohang" trong tên key
        if (key.Contains("cart", StringComparison.OrdinalIgnoreCase) ||
            key.Contains("giohang", StringComparison.OrdinalIgnoreCase))
        {
            var json = Context.Session.GetString(key);
            if (string.IsNullOrEmpty(json)) continue;

            try
            {
                using var doc = JsonDocument.Parse(json);

                // Trường hợp 1: Lưu dạng List<CartItem> (Mảng JSON: [ { "ProductId": 1, "Quantity": 2 }, ... ])
                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    foreach (var item in doc.RootElement.EnumerateArray())
                    {
                        if (item.TryGetProperty("Quantity", out var q) ||
                            item.TryGetProperty("quantity", out q) ||
                            item.TryGetProperty("SoLuong", out q))
                        {
                            cartCount += q.GetInt32();
                        }
                    }
                }
                // Trường hợp 2: Lưu dạng Dictionary<int, int> (Object JSON: { "1": 2, "6": 1 })
                else if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    foreach (var prop in doc.RootElement.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == JsonValueKind.Number)
                        {
                            cartCount += prop.Value.GetInt32();
                        }
                    }
                }

                if (cartCount > 0) break;
            }
            catch
            {
                // Bỏ qua nếu key Session này không phải JSON giỏ hàng
            }
        }
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UltraPokémon Store</title>

    <!-- Bootstrap 5 CSS, Bootstrap Icons & CSS tùy chỉnh của dự án -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!--2. VIDEO NỀN CỐ ĐỊNH XUYÊN SUỐT TRANG WEB (Định nghĩa trong site.css) -->
    <div class="video-background-container">
        <video autoplay muted loop playsinline class="bg-video">
            <source src="~/videos/183279-870457579.mp4" type="video/mp4" />
        </video>
        <!-- Lớp phủ tối 60% giúp nội dung chữ và thẻ bài phía trên nổi bật, dễ đọc -->
        <div class="video-overlay"></div>
    </div>

    <!--  3. HIỆU ỨNG ÁNH ĐÈN VÀNG ÓNG DI CHUYỂN THEO CON TRỎ CHUỘT (.mouse-glow) -->
    <div id="mouseGlow" class="mouse-glow d-none d-md-block"></div>

    <!--  4. KHUNG NỘI DUNG CHÍNH NỔI LÊN TRÊN NỀN VIDEO (.main-content-wrapper)  -->
    <div class="main-content-wrapper d-flex flex-column min-vh-100">

        <!-- THANH ĐIỀU HƯỚNG (NAVBAR) -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark bg-opacity-75 shadow-sm sticky-top" style="backdrop-filter: blur(8px);">
                <div class="container">
                    <!-- Logo thương hiệu UltraPokémon -->
                    <a class="navbar-brand brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-lightning-charge-fill text-warning fs-4"></i>
                        <span>Ultra<span class="text-warning">Pokémon</span></span>
                    </a>

                    <!-- Nút thu gọn menu trên màn hình điện thoại -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <!-- MENU ĐIỀU HƯỚNG BÊN TRÁI -->
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Product" asp-action="Index">Cửa hàng thẻ bài</a>
                            </li>
                            <!-- Nút mở hộp thoại Modal Giới thiệu Shop -->
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="#aboutShopSection" data-bs-toggle="modal" data-bs-target="#aboutShopModal">
                                    <i class="bi bi-info-circle me-1"></i>Giới thiệu Shop
                                </a>
                            </li>

                            @* MENU QUẢN TRỊ DÀNH RIÊNG CHO TÀI KHOẢN CÓ QUYỀN ADMIN HOẶC STAFF *@
                            @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Quản trị hệ thống
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark shadow">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index">
                                                    <i class="bi bi-speedometer2 me-2 text-info"></i>Thống kê Doanh thu
                                                </a>
                                            </li>
                                        }
                                        <li>
                                            <a class="dropdown-item" asp-controller="Product" asp-action="Index">
                                                <i class="bi bi-card-heading me-2 text-warning"></i>Quản lý Kho thẻ bài
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="AdminOrders" asp-action="Index">
                                                <i class="bi bi-receipt-cutoff me-2 text-success"></i>Quản lý Đơn hàng
                                            </a>
                                        </li>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a class="dropdown-item" asp-controller="AdminAccounts" asp-action="Index">
                                                    <i class="bi bi-people-fill me-2 text-danger"></i>Quản lý Tài khoản
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>

                        <!-- CỤM BÊN PHẢI: GIỎ HÀNG (HIỂN THỊ SỐ LƯỢNG LÁ BÀI) & TÀI KHOẢN -->
                        <div class="d-flex align-items-center gap-3">
                            <!-- Nút Giỏ hàng kèm huy hiệu (Badge) màu đỏ hiển thị tổng số lá bài -->
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-warning btn-sm rounded-pill px-3 position-relative">
                                <i class="bi bi-cart3 me-1"></i> Giỏ hàng
                                @if (cartCount > 0)
                                {
                                    <!-- Chỉ hiển thị Badge số lượng khi trong giỏ có từ 1 lá bài trở lên -->
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm">
                                        @cartCount
                                        <span class="visually-hidden">lá bài trong giỏ</span>
                                    </span>
                                }
                            </a>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <!-- Dropdown thông tin tài khoản khi đã đăng nhập -->
                                <div class="dropdown">
                                    <button class="btn btn-light btn-sm rounded-pill dropdown-toggle fw-semibold px-3" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-person-circle text-primary me-1"></i> @User.Identity.Name
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">
                                                <i class="bi bi-bag-check me-2"></i>Đơn hàng của tôi
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm w-100 rounded-pill">
                                                    <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <!-- Nút Đăng nhập / Đăng ký dành cho khách chưa đăng nhập -->
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm rounded-pill px-3">Đăng nhập</a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold text-dark">Đăng ký</a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <!-- KHU VỰC HIỂN THỊ NỘI DUNG CỦA TỪNG TRANG CON (VIEW) -->
        <main role="main" class="container my-4 flex-grow-1">
            @RenderBody()
        </main>

        <!-- 5. PHẦN GIỚI THIỆU SHOP TÍCH HỢP TRỰC TIẾP PHÍA TRÊN FOOTER -->
        <section id="aboutShopSection" class="container mb-4">
            <div class="card bg-dark bg-opacity-75 text-light border-warning border-opacity-50 rounded-4 shadow" style="backdrop-filter: blur(8px);">
                <div class="card-body p-4">
                    <div class="row align-items-center g-4">
                        <div class="col-lg-8">
                            <span class="badge bg-warning text-dark fw-bold mb-2 px-3 py-1 rounded-pill">
                                <i class="bi bi-award-fill me-1"></i> VỀ ULTRAPOKÉMON STORE
                            </span>
                            <h4 class="fw-bold text-warning mb-2">Điểm đến số 1 dành cho cộng đồng sưu tầm thẻ bài Pokémon TCG</h4>
                            <p class="text-light text-opacity-75 small mb-0">
                                UltraPokémon chuyên cung cấp, trao đổi và kiểm định các dòng thẻ bài Pokémon chính hãng từ cơ bản đến các phiên bản hiếm (GX, VMAX, Secret Rare). Cam kết thẻ chuẩn chất lượng, đóng gói chống sốc 3 lớp và hỗ trợ giao hàng toàn quốc.
                            </p>
                        </div>
                        <div class="col-lg-4">
                            <div class="row text-center g-2">
                                <div class="col-4">
                                    <div class="p-2 rounded-3 bg-white bg-opacity-10">
                                        <div class="fw-bold text-warning fs-5">100%</div>
                                        <div class="small text-light text-opacity-75">Chính hãng</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 rounded-3 bg-white bg-opacity-10">
                                        <div class="fw-bold text-info fs-5">6 Hệ</div>
                                        <div class="small text-light text-opacity-75">Đa dạng thẻ</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 rounded-3 bg-white bg-opacity-10">
                                        <div class="fw-bold text-success fs-5">24/7</div>
                                        <div class="small text-light text-opacity-75">Hỗ trợ COD</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CHÂN TRANG (FOOTER) -->
        <footer class="footer bg-dark bg-opacity-75 text-light py-4 mt-auto border-top border-secondary border-opacity-25">
            <div class="container text-center">
                <div class="fw-bold mb-1">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i> UltraPokémon Card Store
                </div>
                <p class="small text-secondary mb-0">
                    Hệ thống phân phối thẻ bài Pokémon TCG chính hãng &bull; Đồ án Lập trình Web ASP.NET Core MVC
                </p>
            </div>
        </footer>
    </div>

    <!--  6. MODAL HỘP THOẠI GIỚI THIỆU SHOP (KÍCH HOẠT KHI BẤM TRÊN NAVBAR)  -->
    <div class="modal fade" id="aboutShopModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border-warning rounded-4">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold text-warning">
                        <i class="bi bi-lightning-charge-fill me-2"></i>Giới thiệu UltraPokémon Store
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Chào mừng các Nhà Huấn Luyện đến với <strong>UltraPokémon Card Store</strong>!</p>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Cam kết chính hãng:</strong> Toàn bộ thẻ bài đều được kiểm định độ hiếm và tình trạng vật lý (Mint/Near Mint).</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Đa dạng hệ nguyên tố:</strong> Fire, Water, Electric, Rock, Grass, Psychic.</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Thanh toán linh hoạt:</strong> Hỗ trợ COD, Chuyển khoản ATM, Ví MoMo và thẻ Visa.</li>
                    </ul>
                </div>
                <div class="modal-footer border-secondary">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-warning fw-bold rounded-pill px-4">Khám phá kho thẻ ngay</a>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. THƯ VIỆN JAVASCRIPT & SCRIPT HIỆU ỨNG ÁNH ĐÈN THEO CHUỘT-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
            // Kích hoạt hiệu ứng ánh đèn vàng óng (.mouse-glow) di chuyển mượt theo tọa độ con trỏ chuột
            document.addEventListener("DOMContentLoaded", function () {
                const mouseGlow = document.getElementById("mouseGlow");
                if (!mouseGlow) return;

                document.addEventListener("mousemove", function (e) {
                    mouseGlow.style.left = e.clientX + "px";
                    mouseGlow.style.top = e.clientY + "px";
                });
            });
    </script>

    <!-- Nạp các script riêng của từng View con (ví dụ: _ValidationScriptsPartial) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>