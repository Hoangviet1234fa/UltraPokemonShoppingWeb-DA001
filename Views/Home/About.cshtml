@{ ViewData["Title"] = "Giới thiệu"; }
<h1>Giới thiệu</h1>
<p>Ultra Pokemon Store - Đồ Án 001 (Nhóm 07). Hệ thống quản lý hệ phái và bộ bài Pokemon TCG.</p>
@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container my-4">
    <!-- Banner / Header -->
    <div class="p-5 mb-4 bg-light rounded-3 text-center border">
        <h1 class="display-5 fw-bold text-primary">ULTRA POKEMON TCG</h1>
        <p class="lead mb-0">Điểm đến lý tưởng dành cho cộng đồng đam mê Pokémon Trading Card Game (TCG)</p>
    </div>

    <!-- Nội dung giới thiệu -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <p class="fs-5">
                <strong>Chào mừng bạn đến với ULTRA POKEMON TCG!</strong><br />
                Dù bạn là một <em>Huấn luyện viên (Trainer)</em> đang tìm kiếm những lá bài mạnh mẽ để hoàn thiện bộ bài thi đấu,
                hay một <em>Nhà sưu tầm (Collector)</em> mải mê săn tìm các lá thẻ hiếm như Secret Rare, Alternate Art, hay PSA graded
                — chúng tôi luôn sẵn sàng đồng hành cùng niềm đam mê của bạn.
            </p>

            <hr class="my-4" />

            <!-- Tại sao chọn chúng tôi -->
            <h3 class="fw-bold mb-3 text-dark">Tại sao nên chọn ULTRA POKEMON TCG?</h3>
            <ul class="list-group list-group-flush mb-4 fs-6">
                <li class="list-group-item">
                    <strong>100% Chính hãng (Authentic):</strong> Cam kết phân phối thẻ bài Pokémon TCG chuẩn từ Pokémon Company, nói không với hàng giả/hàng nhái.
                </li>
                <li class="list-group-item">
                    <strong>Sản phẩm đa dạng:</strong>
                    <ul class="mt-2">
                        <li><strong>Sealed Products:</strong> Booster Box, Elite Trainer Box (ETB), Collection Box, Tin Sheet đầy đủ các Series mới nhất (Scarlet &amp; Violet, Sword &amp; Shield,...).</li>
                        <li><strong>Single Cards:</strong> Thẻ lẻ được phân loại tình trạng rõ ràng (Near Mint, Lightly Played), dễ dàng tìm kiếm từ thẻ Commons cho đến Secret Rare/Illustration Rare.</li>
                        <li><strong>Phụ kiện bảo vệ:</strong> Album lưu trữ, Sleeves, Toploader, Binder từ các thương hiệu uy tín (Ultra Pro, Dragon Shield, Vault X).</li>
                    </ul>
                </li>
                <li class="list-group-item">
                    <strong>Đóng gói cẩn thận &amp; Vận chuyển an toàn:</strong> Mỗi đơn hàng thẻ lẻ đều được sleeve + toploader bảo vệ 3 lớp trước khi giao đến tay bạn.
                </li>
                <li class="list-group-item">
                    <strong>Cộng đồng kết nối:</strong> Hỗ trợ tư vấn build deck cho người mới bắt đầu và cập nhật nhanh nhất meta-game cùng các sự kiện TCG.
                </li>
            </ul>

            <!-- Thông tin liên hệ -->
            <div class="card bg-light border-0 p-3 mt-4">
                <h4 class="fw-bold text-primary mb-3">Thông tin liên hệ &amp; Cửa hàng</h4>
                <p class="mb-1"><strong>Hotline / Zalo:</strong> 0906731188</p>
                <p class="mb-1"><strong>Địa chỉ:</strong> 127/199/99/22/44 Côn Đảo</p>
                <p class="mb-0"><strong>Giờ mở cửa:</strong> 8:00 - 22:00</p>
            </div>
        </div>
    </div>
</div>