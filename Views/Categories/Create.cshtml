@model UltraPokemon.Models.Category
@{
    ViewData["Title"] = "Thêm hệ nguyên tố mới";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="bg-white rounded-4 shadow-sm p-4">
                <h3 class="fw-bold mb-1">Thêm hệ nguyên tố mới</h3>
                <p class="text-muted small mb-3">Ví dụ: Fire, Water, Electric, Grass, Psychic, Dragon...</p>
                <hr />

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold">Tên hệ nguyên tố <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên hệ..." required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary fw-semibold px-4">Lưu danh mục</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}