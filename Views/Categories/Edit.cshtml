@model UltraPokemon.Models.Category
@{
    ViewData["Title"] = "Chỉnh sửa hệ nguyên tố";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="bg-white rounded-4 shadow-sm p-4">
                <h3 class="fw-bold mb-1">Chỉnh sửa hệ nguyên tố</h3>
                <p class="text-muted small mb-3">Tên hệ mới sẽ tự động cập nhật cho toàn bộ thẻ bài thuộc hệ này.</p>
                <hr />

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold">Tên hệ nguyên tố <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary fw-semibold px-4">Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}