@model UltraPokemon.Models.Order

@{
    ViewData["Title"] = $"Chi tiết đơn hàng {Model.OrderCode}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đơn
        </a>
        <h3 class="fw-bold mb-0">
            <i class="bi bi-receipt text-primary me-2"></i>Chi tiết đơn hàng @Model.OrderCode
        </h3>
    </div>

    <div>
        @switch (Model.Status)
        {
            case UltraPokemon.Models.OrderStatus.Pending:
                <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">
                    <i class="bi bi-hourglass-split me-1"></i> Chờ duyệt
                </span>
                break;
            case UltraPokemon.Models.OrderStatus.Shipping:
                <span class="badge bg-info text-dark fs-6 px-3 py-2 rounded-pill">
                    <i class="bi bi-truck me-1"></i> Đang giao
                </span>
                break;
            case UltraPokemon.Models.OrderStatus.Completed:
                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">
                    <i class="bi bi-check-circle me-1"></i> Hoàn thành
                </span>
                break;
            case UltraPokemon.Models.OrderStatus.Cancelled:
                <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">
                    <i class="bi bi-x-circle me-1"></i> Đã hủy
                </span>
                break;
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- CỘT TRÁI: THÔNG TIN KHÁCH HÀNG & SẢN PHẨM -->
    <div class="col-lg-8">
        <!-- Thông tin người nhận -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0"><i class="bi bi-person-vcard text-primary me-2"></i>Thông tin người nhận</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Họ tên người nhận</div>
                        @* Sử dụng đúng thuộc tính FullName của Models/Order.cs *@
                        <div class="fw-bold">@Model.FullName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Email tài khoản đặt hàng</div>
                        @* Sử dụng đúng thuộc tính UserEmail của Models/Order.cs *@
                        <div class="fw-semibold">@Model.UserEmail</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Số điện thoại</div>
                        <div class="fw-bold text-primary">@Model.PhoneNumber</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Ngày đặt hàng</div>
                        <div class="fw-semibold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Hình thức thanh toán</div>
                        <div class="fw-semibold"><span class="badge bg-light text-dark border">@Model.PaymentMethod</span></div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">Địa chỉ giao hàng</div>
                        @* Sử dụng đúng thuộc tính Address của Models/Order.cs *@
                        <div class="fw-semibold">@Model.Address</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border-start border-warning border-4">
                                <div class="text-muted small fw-bold">Ghi chú của khách:</div>
                                <div>@Model.Note</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Danh sách thẻ bài đã đặt -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-box-seam text-primary me-2"></i>Danh sách sản phẩm (@Model.OrderDetails.Sum(x => x.Quantity) thẻ)</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Thẻ bài</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            @* [ĐÃ FIX] Dùng ImageHelper.Resolve tránh lỗi mất ảnh *@
                                            <img src="@(item.Product != null ? ImageHelper.Resolve(Env, item.Product) : "/images/default-card.png")"
                                                 alt="@item.Product?.Name"
                                                 class="rounded-3 border"
                                                 style="width: 48px; height: 64px; object-fit: cover;" />
                                            <div>
                                                <div class="fw-bold">@(item.Product?.Name ?? $"Sản phẩm #{item.ProductId}")</div>
                                                <span class="badge bg-secondary-subtle text-dark small">@item.Product?.ElementType</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">@item.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-center fw-bold">x @item.Quantity</td>
                                    <td class="text-end pe-4 fw-bold text-danger">
                                        @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-6 py-3">TỔNG THANH TOÁN:</td>
                                <td class="text-end pe-4 fw-bold fs-5 text-danger py-3">@Model.TotalAmount.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: XỬ LÝ TRẠNG THÁI ĐƠN HÀNG -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-dark text-white py-3 rounded-top-4">
                <h6 class="fw-bold mb-0"><i class="bi bi-gear-fill me-2"></i>Cập nhật trạng thái đơn</h6>
            </div>
            <div class="card-body">
                @if (Model.Status == UltraPokemon.Models.OrderStatus.Cancelled || Model.Status == UltraPokemon.Models.OrderStatus.Completed)
                {
                    <div class="alert @(Model.Status == UltraPokemon.Models.OrderStatus.Completed ? "alert-success" : "alert-danger") mb-0 rounded-3">
                        <i class="bi bi-lock-fill me-1"></i>
                        Đơn hàng này đã ở trạng thái cuối cùng (<strong>@(Model.Status == UltraPokemon.Models.OrderStatus.Completed ? "Hoàn thành" : "Đã hủy")</strong>) và không thể thay đổi.
                    </div>
                }
                else
                {
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn trạng thái tiếp theo:</label>
                            <select name="newStatus" class="form-select form-select-lg rounded-3">
                                @if (Model.Status == UltraPokemon.Models.OrderStatus.Pending)
                                {
                                    <option value="@UltraPokemon.Models.OrderStatus.Pending" selected>Chờ duyệt</option>
                                    <option value="@UltraPokemon.Models.OrderStatus.Shipping">Xác nhận & Giao hàng</option>
                                    <option value="@UltraPokemon.Models.OrderStatus.Cancelled">Hủy đơn hàng (Hoàn kho)</option>
                                }
                                else if (Model.Status == UltraPokemon.Models.OrderStatus.Shipping)
                                {
                                    <option value="@UltraPokemon.Models.OrderStatus.Shipping" selected>Đang giao</option>
                                    <option value="@UltraPokemon.Models.OrderStatus.Completed">Đã giao thành công (Hoàn tất)</option>
                                    <option value="@UltraPokemon.Models.OrderStatus.Cancelled">Hủy đơn hàng (Hoàn kho)</option>
                                }
                            </select>
                        </div>

                        <div class="alert alert-warning small rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>Lưu ý:</strong> Nếu chọn <em>Hủy đơn hàng</em>, hệ thống sẽ tự động cộng trả lại số lượng thẻ bài vào kho hàng.
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill shadow-sm">
                            <i class="bi bi-save me-1"></i> Cập nhật trạng thái
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>