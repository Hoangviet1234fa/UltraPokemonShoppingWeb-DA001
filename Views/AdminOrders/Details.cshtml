@model UltraPokemon.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container mt-4">
    <!-- Tiêu đề trang và nút quay lại -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Chi tiết đơn hàng <span class="text-primary">#@Model.Id</span></h2>
        <a asp-action="Index" class="btn btn-secondary">&larr; Quay lại danh sách</a>
    </div>
    <hr />

    <!-- Thông báo thành công nếu có -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row mb-4">
        <!-- CỘT 1: THÔNG TIN KHÁCH HÀNG & GIAO HÀNG -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <strong>Thông tin người nhận</strong>
                </div>
                <div class="card-body">
                    <p><strong>Họ tên:</strong> @Model.FullName</p>
                    <p><strong>Email tài khoản:</strong> @Model.UserEmail</p>
                    <p><strong>Số điện thoại:</strong> @Model.PhoneNumber</p>
                    <p><strong>Địa chỉ giao hàng:</strong> @Model.Address</p>
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Hình thức thanh toán:</strong> <span class="badge bg-secondary">@Model.PaymentMethod</span></p>
                </div>
            </div>
        </div>

        <!-- CỘT 2: TRẠNG THÁI & CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <strong>Trạng thái & Thanh toán</strong>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <p class="mb-2">
                            <strong>Trạng thái hiện tại:</strong>
                            <!-- ĐÃ BỔ SUNG TRẠNG THÁI ĐÃ HỦY VÀO PHẦN HIỂN THỊ -->
                            @if ((int)Model.Status == 0)
                            {
                                <span class="badge bg-warning text-dark fs-6">Chờ duyệt</span>
                            }
                            else if ((int)Model.Status == 1)
                            {
                                <span class="badge bg-info text-dark fs-6">Đang giao</span>
                            }
                            else if ((int)Model.Status == 2)
                            {
                                <span class="badge bg-success fs-6">Hoàn thành</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">Đã hủy</span>
                            }
                        </p>
                        <p class="fs-5"><strong>Tổng thanh toán:</strong> <span class="text-danger fw-bold">@Convert.ToDecimal(Model.TotalAmount).ToString("N0") VNĐ</span></p>
                    </div>

                    <!-- FORM CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG (Gửi POST về AdminOrdersController -> UpdateStatus) -->
                    <form asp-action="UpdateStatus" method="post" class="mt-3 pt-3 border-top">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="form-label fw-bold">Cập nhật trạng thái mới:</label>
                        <div class="input-group">
                            <!-- ĐÃ BỔ SUNG OPTION "ĐÃ HỦY" (value="3") VÀO DROPDOWN -->
                            <select name="newStatus" class="form-select">
                                <option value="0" selected="@((int)Model.Status == 0)">Chờ duyệt</option>
                                <option value="1" selected="@((int)Model.Status == 1)">Đang giao</option>
                                <option value="2" selected="@((int)Model.Status == 2)">Hoàn thành</option>
                                <option value="3" selected="@((int)Model.Status == 3)" class="text-danger fw-bold">Đã hủy</option>
                            </select>
                            <button type="submit" class="btn btn-success">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH CÁC THẺ BÀI TRONG ĐƠN -->
    <h4 class="mt-4">Danh sách thẻ bài đã đặt</h4>
    <table class="table table-striped table-bordered align-middle mt-3">
        <thead class="table-secondary">
            <tr>
                <th>Tên thẻ bài</th>
                <th>Hệ</th>
                <th class="text-center">Số lượng</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.OrderDetails)
            {
                var thanhTien = detail.Quantity * Convert.ToDecimal(detail.UnitPrice);
                <tr>
                    <td class="fw-bold">@detail.Product.Name</td>
                    <td><span class="badge bg-info text-dark">@detail.Product.ElementType</span></td>
                    <td class="text-center">@detail.Quantity</td>
                    <td class="text-end">@Convert.ToDecimal(detail.UnitPrice).ToString("N0") đ</td>
                    <td class="text-end fw-bold text-danger">@thanhTien.ToString("N0") đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-light">
                <th colspan="4" class="text-end fs-5">Tổng cộng đơn hàng:</th>
                <th class="text-end fs-5 text-danger fw-bold">@Model.TotalAmount.ToString("N0") VNĐ</th>
            </tr>
        </tfoot>
    </table>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">&larr; Quay lại danh sách</a>
    </div>
</div>