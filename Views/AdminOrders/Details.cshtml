@model UltraPokemon.Models.Order
@using UltraPokemon.Models
@{
    ViewData["Title"] = "Chi tiết đơn hàng " + Model.OrderCode;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Chi tiết đơn hàng <span class="text-primary">@Model.OrderCode</span></h3>
            <span class="text-muted small">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại danh sách</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-4 mb-4">
        <!-- Cột trái: Thông tin khách hàng & Địa chỉ nhận hàng -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold">
                    📍 Thông tin giao nhận
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Người nhận:</strong> @Model.FullName</p>
                    <p class="mb-2"><strong>Số điện thoại:</strong> @Model.PhoneNumber</p>
                    <p class="mb-2"><strong>Email tài khoản:</strong> @Model.UserEmail</p>
                    <p class="mb-0"><strong>Địa chỉ giao hàng:</strong> @Model.Address</p>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông tin thanh toán & Form cập nhật trạng thái -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white fw-bold">
                    💳 Thanh toán & Xử lý đơn hàng
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <p class="mb-2">
                            <strong>Phương thức thanh toán:</strong>
                            <span class="badge bg-info text-dark fs-6 ms-1">@Model.PaymentMethod</span>
                        </p>
                        <p class="mb-3">
                            <strong>Tổng tiền đơn hàng:</strong>
                            <span class="fs-4 fw-bold text-danger ms-1">@Model.TotalAmount.ToString("N0")đ</span>
                        </p>
                    </div>

                    <!-- Form gửi POST tới AdminOrdersController.UpdateStatus(int id, OrderStatus newStatus) -->
                    <form asp-action="UpdateStatus" method="post" class="border-top pt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <label class="form-label small fw-bold text-secondary">Cập nhật trạng thái xử lý:</label>
                        <div class="input-group">
                            <select name="newStatus" class="form-select">
                                @foreach (var item in Html.GetEnumSelectList<OrderStatus>())
                                {
                                    <option value="@item.Value" selected="@(item.Value == ((int)Model.Status).ToString())">
                                        @item.Text
                                    </option>
                                }
                            </select>
                            <button type="submit" class="btn btn-success fw-bold px-4">Lưu trạng thái</button>
                        </div>
                        <div class="form-text small">
                            * Lưu ý: Chuyển sang <strong>Đã hủy</strong> sẽ tự động hoàn trả số lượng lá bài về lại kho.
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng chi tiết các lá bài Pokémon trong đơn -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light fw-bold">
            🃏 Danh sách lá bài Pokémon đã đặt
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tên lá bài</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá lúc mua</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <tr>
                            <td class="fw-semibold">@(detail.Product?.Name ?? $"Sản phẩm #{detail.ProductId}")</td>
                            <td class="text-center">x@(detail.Quantity)</td>
                            <td class="text-end">@detail.UnitPrice.ToString("N0")đ</td>
                            <td class="text-end fw-bold text-danger">@((detail.UnitPrice * detail.Quantity).ToString("N0"))đ</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="3" class="text-end fw-bold fs-5">Tổng cộng thanh toán:</td>
                        <td class="text-end fw-bold fs-4 text-danger">@Model.TotalAmount.ToString("N0")đ</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>