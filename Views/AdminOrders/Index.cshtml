@model IEnumerable<UltraPokemon.Models.Order>

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    string currentSearch = ViewBag.Search as string ?? "";
    string currentStatus = ViewBag.Status as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-receipt-cutoff text-primary me-2"></i>Quản lý Đơn hàng
        </h3>
        <p class="text-muted small mb-0">Theo dõi, duyệt giao và xử lý các đơn đặt thẻ bài từ khách hàng</p>
    </div>

    <div class="d-flex gap-2">
        <span class="badge bg-dark fs-6 px-3 py-2 rounded-pill">
            Tổng: @(ViewBag.TotalItems ?? Model.Count()) đơn hàng
        </span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- BỘ LỌC & TÌM KIẾM -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold small text-muted">Tìm kiếm đơn hàng</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control"
                           placeholder="Nhập mã đơn (#ULTRA...), tên người nhận, email hoặc SĐT..." />
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted">Trạng thái đơn</label>
                <select name="status" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Pending" selected="@(currentStatus == "Pending")">Chờ duyệt</option>
                    <option value="Shipping" selected="@(currentStatus == "Shipping")">Đang giao</option>
                    <option value="Completed" selected="@(currentStatus == "Completed")">Hoàn thành</option>
                    <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Đã hủy</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH ĐƠN HÀNG -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">Mã Đơn</th>
                    <th>Người nhận & Liên hệ</th>
                    <th>Ngày đặt</th>
                    <th>Thanh toán</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Không tìm thấy đơn hàng nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var order in Model)
                    {
                        <tr>
                            @* Sử dụng thuộc tính OrderCode (#ULTRA000001) từ Models/Order.cs *@
                            <td class="ps-4 fw-bold text-primary">@order.OrderCode</td>
                            <td>
                                @* Sử dụng đúng tên thuộc tính FullName và UserEmail *@
                                <div class="fw-bold">@order.FullName</div>
                                <div class="small text-muted">
                                    <i class="bi bi-telephone me-1"></i>@order.PhoneNumber &bull; @order.UserEmail
                                </div>
                            </td>
                            <td>
                                <div>@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted">@order.OrderDate.ToString("HH:mm")</div>
                            </td>
                            <td>
                                @* Hiển thị phương thức thanh toán kèm trạng thái đã thu tiền (IsPaid) *@
                                <div class="d-flex flex-column align-items-start gap-1">
                                    <span class="badge bg-light text-dark border">@order.PaymentMethod</span>
                                    @if (order.IsPaid)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            <i class="bi bi-clock me-1"></i>Chưa thanh toán
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</td>
                            <td>
                                @switch (order.Status)
                                {
                                    case UltraPokemon.Models.OrderStatus.Pending:
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                            <i class="bi bi-hourglass-split me-1"></i> Chờ duyệt
                                        </span>
                                        break;
                                    case UltraPokemon.Models.OrderStatus.Shipping:
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                            <i class="bi bi-truck me-1"></i> Đang giao
                                        </span>
                                        break;
                                    case UltraPokemon.Models.OrderStatus.Completed:
                                        <span class="badge bg-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i> Hoàn thành
                                        </span>
                                        break;
                                    case UltraPokemon.Models.OrderStatus.Cancelled:
                                        <span class="badge bg-danger px-3 py-2 rounded-pill">
                                            <i class="bi bi-x-circle me-1"></i> Đã hủy
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> Chi tiết
                                    </a>

                                    @if (order.Status == UltraPokemon.Models.OrderStatus.Pending)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <input type="hidden" name="newStatus" value="@UltraPokemon.Models.OrderStatus.Shipping" />
                                            <button type="submit" class="btn btn-sm btn-info text-dark rounded-pill px-3" title="Duyệt giao hàng">
                                                <i class="bi bi-truck"></i> Duyệt giao
                                            </button>
                                        </form>
                                    }
                                    else if (order.Status == UltraPokemon.Models.OrderStatus.Shipping)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <input type="hidden" name="newStatus" value="@UltraPokemon.Models.OrderStatus.Completed" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3" title="Xác nhận hoàn thành">
                                                <i class="bi bi-check2-all"></i> Hoàn tất
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- PHÂN TRANG -->
@if (totalPages > 1)
{
    <nav class="mt-4 d-flex justify-content-center">
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@currentSearch"
                       asp-route-status="@currentStatus">@i</a>
                </li>
            }
        </ul>
    </nav>
}