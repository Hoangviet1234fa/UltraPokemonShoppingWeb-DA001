@model IEnumerable<UltraPokemon.Models.Order>
@using UltraPokemon.Models
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    int? currentStatus = ViewBag.CurrentStatus;
}

<!-- Nhúng Bootstrap Icons đồng bộ với trang Admin Dashboard -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="container py-4">
    
    <!-- 1. HEADER KHỐI TRẮNG TƯƠNG PHẢN CAO -->
  
    <div class="bg-white rounded-4 shadow-sm p-4 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-controller="AdminDashboard" asp-action="Index" class="text-decoration-none">Bảng điều khiển</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Đơn hàng</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1">Quản lý đơn hàng</h3>
            <p class="text-muted small mb-0">Theo dõi tiến độ xử lý, đối soát thanh toán online và cập nhật giao vận</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-outline-secondary fw-semibold d-inline-flex align-items-center gap-2">
                <i class="bi bi-bar-chart-line"></i>
                <span>Báo cáo doanh thu</span>
            </a>
        </div>
    </div>

    <!-- Thông báo phản hồi thao tác -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

   
    <!-- 2. KHUNG LÀM VIỆC CHÍNH: TAB TRẠNG THÁI + BỘ LỌC + BẢNG DỮ LIỆU       -->
    
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- Thanh Tab phân loại nhanh theo trạng thái (Chuẩn Shopee / Shopify Admin) -->
        <div class="bg-white border-bottom px-4 pt-3">
            <ul class="nav nav-underline order-tabs gap-4">
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == null ? "active" : "")"
                       asp-action="Index" asp-route-search="@ViewBag.CurrentSearch" asp-route-paymentMethod="@ViewBag.CurrentPaymentMethod">
                        Tất cả <span class="tab-badge">@(ViewBag.CountAll ?? Model.Count())</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == 0 ? "active" : "")"
                       asp-action="Index" asp-route-status="0" asp-route-search="@ViewBag.CurrentSearch" asp-route-paymentMethod="@ViewBag.CurrentPaymentMethod">
                        Chờ duyệt <span class="tab-badge badge-pending">@(ViewBag.CountPending ?? 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == 1 ? "active" : "")"
                       asp-action="Index" asp-route-status="1" asp-route-search="@ViewBag.CurrentSearch" asp-route-paymentMethod="@ViewBag.CurrentPaymentMethod">
                        Đang giao <span class="tab-badge badge-shipping">@(ViewBag.CountShipping ?? 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == 2 ? "active" : "")"
                       asp-action="Index" asp-route-status="2" asp-route-search="@ViewBag.CurrentSearch" asp-route-paymentMethod="@ViewBag.CurrentPaymentMethod">
                        Hoàn thành <span class="tab-badge badge-completed">@(ViewBag.CountCompleted ?? 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == 3 ? "active" : "")"
                       asp-action="Index" asp-route-status="3" asp-route-search="@ViewBag.CurrentSearch" asp-route-paymentMethod="@ViewBag.CurrentPaymentMethod">
                        Đã hủy <span class="tab-badge badge-cancelled">@(ViewBag.CountCancelled ?? 0)</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Thanh tìm kiếm & bộ lọc kết hợp -->
        <div class="p-4 bg-light bg-opacity-50 border-bottom">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                @if (currentStatus.HasValue)
                {
                    <input type="hidden" name="status" value="@currentStatus.Value" />
                }

                <div class="col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" value="@ViewBag.CurrentSearch"
                               class="form-control border-start-0 ps-0"
                               placeholder="Tìm theo mã đơn (#ULTRA...), tên khách, SĐT hoặc email..." />
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted small">
                            <i class="bi bi-credit-card me-1"></i> Thanh toán
                        </span>
                        <select name="paymentMethod" class="form-select">
                            <option value="">Tất cả phương thức</option>
                            <option value="Tiền mặt (COD)" selected="@(ViewBag.CurrentPaymentMethod == "Tiền mặt (COD)")">Tiền mặt (COD)</option>
                            <option value="Ví Momo" selected="@(ViewBag.CurrentPaymentMethod == "Ví Momo")">Ví MoMo</option>
                            <option value="Chuyển khoản Ngân hàng (ATM)" selected="@(ViewBag.CurrentPaymentMethod == "Chuyển khoản Ngân hàng (ATM)")">ATM / Napas</option>
                            <option value="Visa Card" selected="@(ViewBag.CurrentPaymentMethod == "Visa Card")">Thẻ Visa</option>
                        </select>
                    </div>
                </div>

                <div class="col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary fw-semibold flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-funnel"></i> Áp dụng
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center px-3" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>

        <!-- Bảng danh sách đơn hàng -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3 fw-semibold">Mã đơn hàng</th>
                        <th class="py-3 fw-semibold">Khách hàng & Giao nhận</th>
                        <th class="py-3 fw-semibold">Phương thức</th>
                        <th class="py-3 fw-semibold text-end">Tổng thanh toán</th>
                        <th class="py-3 fw-semibold text-center">Trạng thái</th>
                        <th class="pe-4 py-3 fw-semibold text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted mb-2"><i class="bi bi-inbox fs-1"></i></div>
                                <h6 class="fw-bold text-dark mb-1">Không có đơn hàng nào</h6>
                                <p class="text-muted small mb-0">Thử thay đổi từ khóa tìm kiếm hoặc chọn tab trạng thái khác.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <!-- Cột 1: Mã đơn & Thời gian -->
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-primary text-decoration-none font-monospace">
                                        @item.OrderCode
                                    </a>
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-clock me-1"></i>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>

                                <!-- Cột 2: Thông tin khách hàng & Địa chỉ (Dùng icon mảnh thay emoji) -->
                                <td>
                                    <div class="fw-bold text-dark">@item.FullName</div>
                                    <div class="small text-muted d-flex flex-wrap align-items-center gap-2 mt-1">
                                        <span><i class="bi bi-telephone me-1"></i>@item.PhoneNumber</span>
                                        <span class="text-black-50">•</span>
                                        <span><i class="bi bi-envelope me-1"></i>@item.UserEmail</span>
                                    </div>
                                    <div class="small text-secondary text-truncate mt-1" style="max-width: 290px;" title="@item.Address">
                                        <i class="bi bi-geo-alt me-1"></i>@item.Address
                                    </div>
                                </td>

                                <!-- Cột 3: Cổng thanh toán -->
                                <td>
                                    @if (item.PaymentMethod == "Ví Momo")
                                    {
                                        <span class="pay-badge pay-momo"><i class="bi bi-qr-code me-1"></i>Ví MoMo</span>
                                    }
                                    else if (item.PaymentMethod == "Chuyển khoản Ngân hàng (ATM)")
                                    {
                                        <span class="pay-badge pay-atm"><i class="bi bi-bank me-1"></i>ATM Napas</span>
                                    }
                                    else if (item.PaymentMethod == "Visa Card")
                                    {
                                        <span class="pay-badge pay-visa"><i class="bi bi-credit-card-2-front me-1"></i>Visa Card</span>
                                    }
                                    else
                                    {
                                        <span class="pay-badge pay-cod"><i class="bi bi-cash-stack me-1"></i>COD</span>
                                    }
                                </td>

                                <!-- Cột 4: Tổng tiền -->
                                <td class="text-end fw-bold text-dark" style="font-variant-numeric: tabular-nums;">
                                    @item.TotalAmount.ToString("N0")đ
                                </td>

                                <!-- Cột 5: Trạng thái dạng Soft Pill có chấm tròn -->
                                <td class="text-center">
                                    @switch (item.Status)
                                    {
                                        case OrderStatus.Pending:
                                            <span class="status-pill status-pending"><span class="dot"></span>Chờ duyệt</span>
                                            break;
                                        case OrderStatus.Shipping:
                                            <span class="status-pill status-shipping"><span class="dot"></span>Đang giao</span>
                                            break;
                                        case OrderStatus.Completed:
                                            <span class="status-pill status-completed"><span class="dot"></span>Hoàn thành</span>
                                            break;
                                        case OrderStatus.Cancelled:
                                            <span class="status-pill status-cancelled"><span class="dot"></span>Đã hủy</span>
                                            break;
                                    }
                                </td>

                                <!-- Cột 6: Thao tác nhanh -->
                                <td class="pe-4 text-end text-nowrap">
                                    <!-- Nút duyệt nhanh 1 chạm nếu đơn đang Chờ duyệt -->
                                    @if (item.Status == OrderStatus.Pending)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline me-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="newStatus" value="@OrderStatus.Shipping" />
                                            <button type="submit" class="btn btn-sm btn-success fw-semibold" title="Duyệt và chuyển sang Đang giao">
                                                <i class="bi bi-check2 me-1"></i>Duyệt
                                            </button>
                                        </form>
                                    }

                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary fw-semibold me-1">
                                        Chi tiết
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Xác nhận xóa vĩnh viễn đơn hàng @item.OrderCode?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa đơn hàng">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Style cho thanh Tab trạng thái */
    .order-tabs .nav-link {
        color: #64748b;
        font-weight: 600;
        font-size: 0.92rem;
        padding-bottom: 0.85rem;
        border-bottom-width: 3px;
    }

        .order-tabs .nav-link:hover {
            color: #0f172a;
        }

        .order-tabs .nav-link.active {
            color: #1d4ed8;
            border-bottom-color: #1d4ed8;
        }

    .tab-badge {
        display: inline-block;
        background: #f1f5f9;
        color: #475569;
        font-size: 0.75rem;
        padding: 2px 8px;
        border-radius: 999px;
        margin-left: 4px;
    }

    .nav-link.active .tab-badge {
        background: #dbeafe;
        color: #1d4ed8;
    }

    /* Style cho Badge Cổng thanh toán */
    .pay-badge {
        display: inline-flex;
        align-items: center;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 6px;
    }

    .pay-momo {
        background: #fdf2f8;
        color: #a50064;
        border: 1px solid #fbcfe8;
    }

    .pay-atm {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

    .pay-visa {
        background: #eef2ff;
        color: #1e1b4b;
        border: 1px solid #c7d2fe;
    }

    .pay-cod {
        background: #f8fafc;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    /* Style cho Badge Trạng thái dạng Soft Pill có chấm tròn */
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 999px;
    }

        .status-pill .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

        .status-pending .dot {
            background: #f59e0b;
        }

    .status-shipping {
        background: #e0f2fe;
        color: #075985;
    }

        .status-shipping .dot {
            background: #0284c7;
        }

    .status-completed {
        background: #dcfce7;
        color: #166534;
    }

        .status-completed .dot {
            background: #16a34a;
        }

    .status-cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

        .status-cancelled .dot {
            background: #dc2626;
        }
</style>