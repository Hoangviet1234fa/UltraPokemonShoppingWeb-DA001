@model IEnumerable<UltraPokemon.Models.Order>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">Quản lý Đơn hàng</h2>

    <!-- Khối hiển thị thông báo lỗi hoặc thành công từ hệ thống -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <!-- Bảng hiển thị danh sách toàn bộ hóa đơn của khách hàng -->
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã ĐH</th>
                    <th>Email Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái & Cập nhật</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- Hiển thị mã đơn hàng dạng #ID -->
                        <td class="fw-bold">#@item.Id</td>

                        <!-- Hiển thị email người đặt -->
                        <td>@item.UserEmail</td>

                        <!-- Định dạng ngày giờ đặt hàng chuẩn Việt Nam -->
                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>

                        <!-- Hiển thị tổng tiền có dấu phân cách hàng nghìn (N0) -->
                        <td class="text-danger fw-bold">@Convert.ToDecimal(item.TotalAmount).ToString("N0") VNĐ</td>

                        <!-- Cột Trạng thái kèm form cập nhật trực tiếp (Chờ duyệt / Đang giao / Hoàn thành) -->
                        <td>
                            <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center">
                                <input type="hidden" name="id" value="@item.Id" />

                                <!-- Sử dụng name="newStatus" khớp tuyệt đối với tham số của hàm trong AdminOrdersController -->
                                <select name="newStatus" class="form-select form-select-sm me-2" style="width: 150px;">
                                    <option value="0" selected="@((int)item.Status == 0)">Chờ duyệt</option>
                                    <option value="1" selected="@((int)item.Status == 1)">Đang giao</option>
                                    <option value="2" selected="@((int)item.Status == 2)">Hoàn thành</option>
                                </select>

                                <button type="submit" class="btn btn-primary btn-sm">Lưu</button>
                            </form>
                        </td>

                        <!-- Cột Thao tác: Xem chi tiết hóa đơn hoặc Xóa đơn hàng -->
                        <td>
                            <div class="d-flex gap-1">
                                <!-- Nút chuyển hướng sang trang Details để xem các lá bài cụ thể trong đơn -->
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white">Chi tiết</a>

                                <!-- Form xóa đơn hàng có hộp thoại JavaScript xác nhận trước khi xóa -->
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>