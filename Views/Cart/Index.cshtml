@model List<CartLine>
@{ ViewData["Title"] = "Giỏ hàng"; }

<h2>Giỏ hàng</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Giỏ hàng đang trống.
        <a asp-controller="Product" asp-action="Index">Tiếp tục mua sắm</a></div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Thẻ bài</th><th>Hệ</th><th class="text-end">Đơn giá</th><th class="text-center">SL</th><th class="text-end">Thành tiền</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td><a asp-controller="Product" asp-action="Details" asp-route-id="@l.Product.Id">@l.Product.Name</a></td>
                <td>@l.Product.ElementType</td>
                <td class="text-end">@l.Product.Price.ToString("N0") VNĐ</td>
                <td class="text-center">@l.Quantity</td>
                <td class="text-end">@l.Total.ToString("N0") VNĐ</td>
                <td class="text-end">
                    <form asp-action="Remove" method="post">
                        <input type="hidden" name="id" value="@l.Product.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Tổng cộng</th>
                <th class="text-end text-danger">@Model.Sum(l => l.Total).ToString("N0") VNĐ</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <form asp-action="Clear" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Xóa toàn bộ giỏ</button>
    </form>
    <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-sm">Tiếp tục mua sắm</a>
}
