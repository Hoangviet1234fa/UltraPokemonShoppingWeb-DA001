@model UltraPokemon.Models.Order
@{
    ViewData["Title"] = "Cổng thanh toán MoMo / VietQR";

    // Cấu hình tài khoản nhận tiền (khớp với tài khoản trên QR của bạn)
    string bankId = "VCB"; // Vietcombank
    string accountNo = "1066241116";
    string accountName = "NGUYEN VIET HOANG VIET";

    // Lấy số tiền nguyên và mã đơn không dấu '#' để nhúng vào mã QR
    long amount = (long)Math.Round(Model.TotalAmount);
    string transferContent = (Model.OrderCode ?? $"ULTRA{Model.Id:D6}").Replace("#", "").Trim();

    // Link tạo ảnh VietQR động: tự động điền sẵn số tiền & nội dung khi quét bằng MoMo / App Ngân hàng
    string dynamicQrUrl = $"https://img.vietqr.io/image/{bankId}-{accountNo}-qr_only.png" +
                          $"?amount={amount}" +
                          $"&addInfo={Uri.EscapeDataString(transferContent)}" +
                          $"&accountName={Uri.EscapeDataString(accountName)}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- HEADER MÀU ĐẶC TRƯNG MOMO -->
                <div class="p-4 text-white d-flex flex-wrap justify-content-between align-items-center gap-3"
                     style="background: linear-gradient(135deg, #a50064 0%, #d82d8b 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-25 rounded-3 p-2.5 d-flex align-items-center justify-content-center">
                            <i class="bi bi-qr-code-scan fs-3"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">Cổng thanh toán MoMo / VietQR</h4>
                            <p class="mb-0 small text-white-50">
                                Quét mã QR bằng ứng dụng MoMo hoặc ứng dụng Ngân hàng bất kỳ
                            </p>
                        </div>
                    </div>

                    <div class="bg-dark bg-opacity-25 px-3 py-2 rounded-3 text-end">
                        <div class="small text-white-50" style="font-size: 0.75rem;">Giao dịch hết hạn sau</div>
                        <div id="countdownTimer" class="fw-bold text-warning fs-5 font-mono-stat">10:00</div>
                    </div>
                </div>

                <!-- NỘI DUNG CHÍNH -->
                <div class="card-body bg-white p-4 p-lg-5">
                    <div class="row g-4 align-items-center">

                        <!-- CỘT TRÁI: MÃ QR ĐỘNG -->
                        <div class="col-md-5 text-center">
                            <div class="border rounded-4 p-3 shadow-sm bg-light">
                                <div class="small fw-bold text-secondary mb-2">
                                    <i class="bi bi-shield-check text-success me-1"></i>MÃ THANH TOÁN CHÍNH THỨC
                                </div>

                                <div class="bg-white p-2 rounded-3 border d-inline-block">
                                    <img src="@dynamicQrUrl"
                                         alt="Mã QR thanh toán đơn hàng @transferContent"
                                         class="img-fluid"
                                         style="width: 220px; height: 220px; object-fit: contain;" />
                                </div>

                                <div class="small text-muted mt-3" style="font-size: 0.8rem;">
                                    Mở ứng dụng <strong>MoMo</strong> hoặc <strong>App Ngân hàng</strong> &rarr;<br />
                                    Chọn <strong>Quét mã QR</strong> (tự động điền số tiền &amp; nội dung)
                                </div>
                            </div>
                        </div>

                        <!-- CỘT PHẢI: CHI TIẾT ĐƠN HÀNG & XÁC NHẬN -->
                        <div class="col-md-7">
                            <div class="border rounded-4 p-3 p-lg-4 mb-3 bg-light bg-opacity-50">
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">Mã đơn hàng</span>
                                    <span class="fw-bold text-dark font-mono-stat">@Model.OrderCode</span>
                                </div>

                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">Người nhận hàng</span>
                                    <span class="fw-bold text-dark">@Model.FullName</span>
                                </div>

                                <div class="py-2 border-bottom">
                                    <div class="text-muted small mb-1">Số tiền thanh toán</div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-danger fs-3 font-mono-stat">@Model.TotalAmount.ToString("N0")đ</span>
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                onclick="copyText('@amount', this)">
                                            <i class="bi bi-clipboard me-1"></i>Sao chép
                                        </button>
                                    </div>
                                </div>

                                <div class="pt-2">
                                    <div class="text-muted small mb-1">Nội dung chuyển khoản (Bắt buộc)</div>
                                    <div class="d-flex justify-content-between align-items-center bg-white border rounded-2 px-3 py-2">
                                        <span class="fw-bold text-primary font-mono-stat">@transferContent</span>
                                        <button type="button" class="btn btn-outline-primary btn-sm"
                                                onclick="copyText('@transferContent', this)">
                                            <i class="bi bi-clipboard me-1"></i>Sao chép
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-warning small rounded-3 mb-3">
                                <i class="bi bi-info-circle-fill me-1"></i>
                                Sau khi quét mã và chuyển khoản thành công, vui lòng nhấn nút
                                <strong>"Tôi đã thanh toán"</strong> bên dưới để hệ thống ghi nhận đơn hàng.
                            </div>

                            <!-- FORM XÁC NHẬN ĐÃ THANH TOÁN -->
                            <form asp-controller="Cart" asp-action="ConfirmOnlinePayment" method="post" class="mb-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@Model.Id" />
                                <button type="submit"
                                        class="btn text-white fw-bold w-100 py-3 rounded-3 shadow-sm"
                                        style="background-color: #a50064;">
                                    <i class="bi bi-check-circle-fill me-2"></i>TÔI ĐÃ THANH TOÁN (@Model.TotalAmount.ToString("N0")đ)
                                </button>
                            </form>

                            <a asp-controller="Cart" asp-action="MyOrders"
                               class="btn btn-outline-secondary w-100 py-2 rounded-3 small fw-semibold">
                                Thanh toán sau &bull; Xem đơn hàng của tôi
                            </a>

                            <a asp-controller="Cart" asp-action="Index"
                               class="btn btn-light border text-secondary w-100 py-2 rounded-3 small fw-semibold mt-2">
                                &larr; Quay lại giỏ hàng (Hủy thanh toán)
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hàm sao chép nhanh số tiền / nội dung chuyển khoản
        function copyText(text, btn) {
            navigator.clipboard.writeText(text).then(() => {
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Đã chép';
                setTimeout(() => btn.innerHTML = originalHtml, 1500);
            });
        }

        // Bộ đếm ngược thời gian giao dịch 10 phút
        document.addEventListener("DOMContentLoaded", function () {
            let seconds = 10 * 60;
            const timerEl = document.getElementById("countdownTimer");
            const interval = setInterval(function () {
                seconds--;
                if (seconds <= 0) {
                    clearInterval(interval);
                    timerEl.textContent = "00:00";
                    return;
                }
                const m = String(Math.floor(seconds / 60)).padStart(2, '0');
                const s = String(seconds % 60).padStart(2, '0');
                timerEl.textContent = `${m}:${s}`;
            }, 1000);
        });
    </script>
}