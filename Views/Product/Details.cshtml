@model UltraPokemon.Models.Product
@using Microsoft.AspNetCore.Hosting
@using UltraPokemon.Models
@using UltraPokemon.Helpers
@inject IWebHostEnvironment Env

@{
    ViewData["Title"] = "Chi tiết - " + Model.Name;
    var related = ViewBag.Related as List<Product> ?? new List<Product>();
    var color = ElementHelper.Color(Model.ElementType);
    var powerPct = Math.Min(100, (int)Math.Round(Model.Power / 200.0 * 100));
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-secondary mb-3">&larr; Quay lại danh sách</a>

    <div class="row">
        <!-- Hình ảnh lớn -->
        <div class="col-md-5 text-center">
            <div class="detail-card-wrap card-sparkle d-inline-block rounded">
                <img src="@ImageHelper.Resolve(Env, Model)"
                     onerror="this.onerror=null;this.src=this.dataset.fallback;" data-fallback="@ImageHelper.Placeholder(Model)"
                     alt="@Model.Name" class="img-fluid rounded shadow" style="max-height: 480px;" />
            </div>
        </div>

        <!-- Giá, Hệ, Sức mạnh -->
        <div class="col-md-7">
            <h2>@Model.Name</h2>
            <hr />
            <h3 class="text-danger fw-bold mb-3">Giá: @Model.Price.ToString("N0") VNĐ</h3>

            <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item">
                    <strong>Hệ:</strong>
                    <span class="badge bg-@color @(color == "warning" ? "text-dark" : "")">@Model.ElementType</span>
                </li>
                <li class="list-group-item">
                    <strong>Chỉ số sức mạnh (Power):</strong> <span class="badge bg-danger">⚡ @Model.Power HP / ATK</span>
                    <div class="progress mt-2" style="height: 10px;">
                        <div class="progress-bar bg-@color" role="progressbar" style="width: @(powerPct)%"></div>
                    </div>
                </li>
            </ul>

            <div>
                <h5>Mô tả lá bài:</h5>
                <p>@Model.Description</p>
            </div>

            <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <button type="submit" class="btn btn-success btn-lg mt-3">Thêm vào giỏ hàng</button>
            </form>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary mt-3 ms-2">Sửa</a>
        </div>
    </div>

    @if (related.Any())
    {
        <h4 class="mt-5">Thẻ cùng hệ @Model.ElementType</h4>
        <div class="row mt-3">
            @foreach (var r in related)
            {
                <div class="col-6 col-md-3 mb-4"><partial name="_ProductCard" model="r" /></div>
            }
        </div>
    }
</div>