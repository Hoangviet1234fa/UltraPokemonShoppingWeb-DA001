@model IEnumerable<UltraPokemon.Models.Product>
@using UltraPokemon.Models
@using UltraPokemon.Helpers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@{
    ViewData["Title"] = "Danh sách thẻ bài Pokémon";

    string searchString = ViewBag.CurrentFilter ?? string.Empty;
    string selectedElement = ViewBag.CurrentElement ?? string.Empty;
    string sortOrder = ViewBag.CurrentSort ?? string.Empty;
    var availableElements = ViewBag.Elements as List<string> ?? new List<string>();

    int totalItems = ViewBag.TotalItems ?? Model.Count();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    bool isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");

    bool hasActiveFilter = !string.IsNullOrWhiteSpace(searchString)
                        || !string.IsNullOrWhiteSpace(selectedElement)
                        || !string.IsNullOrWhiteSpace(sortOrder);
}

<div class="container py-3">
    <!-- 1. KHỐI TIÊU ĐỀ & BỘ LỌC TÌM KIẾM -->
    <div class="bg-white rounded-4 shadow-sm p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
            <div>
                <h3 class="fw-bold text-dark mb-1">Danh Sách Thẻ Bài Pokémon</h3>
                <p class="text-muted small mb-0">
                    Tìm thấy <strong class="text-primary">@totalItems</strong> thẻ bài phù hợp
                    @if (!string.IsNullOrWhiteSpace(searchString))
                    {
                        <span>cho từ khóa "<strong>@searchString</strong>"</span>
                    }
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                @if (hasActiveFilter)
                {
                    <a asp-controller="Product" asp-action="Index"
                       class="btn btn-sm btn-outline-danger fw-semibold px-3 rounded-3 d-inline-flex align-items-center gap-1">
                        <i class="bi bi-x-circle"></i>
                        <span>Xóa bộ lọc</span>
                    </a>
                }

                @if (isAdmin)
                {
                    <a asp-controller="Categories" asp-action="Index"
                       class="btn btn-sm btn-outline-primary fw-semibold px-3 rounded-3 d-inline-flex align-items-center gap-1">
                        <i class="bi bi-tags"></i>
                        <span>Quản lý Hệ</span>
                    </a>
                    <a asp-controller="Product" asp-action="Create"
                       class="btn btn-sm btn-success fw-semibold px-3 rounded-3 d-inline-flex align-items-center gap-1">
                        <i class="bi bi-plus-circle"></i>
                        <span>Thêm thẻ bài mới</span>
                    </a>
                }
            </div>
        </div>

        @if (ViewBag.SearchNote != null)
        {
            <div class="alert alert-info py-2 small mb-3">@ViewBag.SearchNote</div>
        }

        <!-- Form Tìm kiếm & Sắp xếp -->
        <form asp-controller="Product" asp-action="Index" method="get" class="row g-2 align-items-center mb-3">
            @if (!string.IsNullOrWhiteSpace(selectedElement))
            {
                <input type="hidden" name="elementType" value="@selectedElement" />
            }

            <div class="col-lg-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="search" name="searchString" value="@searchString"
                           class="form-control border-start-0 ps-1"
                           placeholder="Nhập tên lá bài (ví dụ: Charizard, Pikachu)..." />
                </div>
            </div>

            <div class="col-sm-8 col-lg-4">
                <select name="sortOrder" class="form-select" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(sortOrder))">Sắp xếp mặc định (A &rarr; Z)</option>
                    <option value="price_asc" selected="@(sortOrder == "price_asc")">Giá: Thấp đến Cao</option>
                    <option value="price_desc" selected="@(sortOrder == "price_desc")">Giá: Cao đến Thấp</option>
                    <option value="power_desc" selected="@(sortOrder == "power_desc")">Sức mạnh: Cao nhất</option>
                    <option value="name_desc" selected="@(sortOrder == "name_desc")">Tên thẻ: Z &rarr; A</option>
                    <option value="newest" selected="@(sortOrder == "newest")">Mới cập nhật</option>
                </select>
            </div>

            <div class="col-sm-4 col-lg-2">
                <button type="submit" class="btn btn-primary fw-semibold w-100 d-inline-flex align-items-center justify-content-center gap-1">
                    <i class="bi bi-search"></i>
                    <span>Tìm kiếm</span>
                </button>
            </div>
        </form>

        <!-- Dải nút lọc nhanh theo Hệ nguyên tố -->
        <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
            <span class="text-muted small fw-semibold me-1">Lọc theo Hệ:</span>

            <a asp-controller="Product" asp-action="Index"
               asp-route-searchString="@searchString"
               asp-route-sortOrder="@sortOrder"
               class="tcg-filter-pill @(string.IsNullOrEmpty(selectedElement) ? "active" : "")">
                Tất cả
            </a>

            @foreach (var el in availableElements)
            {
                bool isActive = string.Equals(selectedElement, el, StringComparison.OrdinalIgnoreCase);
                <a asp-controller="Product" asp-action="Index"
                   asp-route-elementType="@el"
                   asp-route-searchString="@searchString"
                   asp-route-sortOrder="@sortOrder"
                   class="tcg-filter-pill @(isActive ? "active" : "")">
                    @el
                </a>
            }
        </div>
    </div>

    <!-- 2. LƯỚI HIỂN THỊ DANH SÁCH THẺ BÀI -->
    @if (!Model.Any())
    {
        <div class="bg-white rounded-4 shadow-sm p-5 text-center">
            <div class="text-muted mb-2"><i class="bi bi-search fs-1"></i></div>
            <h5 class="fw-bold text-dark mb-1">Không tìm thấy thẻ bài nào</h5>
            <p class="text-muted small mb-3">Thử tìm với tên Pokémon khác hoặc xóa bớt điều kiện lọc hiện tại.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary fw-semibold px-4">
                Xem tất cả thẻ bài
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                bool inStock = item.Stock > 0;
                string cardImg = ImageHelper.Resolve(_env, item);

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden tcg-product-card">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"
                           class="tcg-img-stage text-decoration-none position-relative">
                            <img src="@cardImg"
                                 onerror="this.onerror=null;this.src=this.dataset.fallback;"
                                 data-fallback="@ImageHelper.Placeholder(item)"
                                 alt="@item.Name" class="tcg-card-photo" loading="lazy" />

                            <span class="badge @(inStock ? "bg-dark bg-opacity-75" : "bg-danger") position-absolute top-0 end-0 m-2 px-2 py-1">
                                @(inStock ? $"Còn {item.Stock}" : "Hết hàng")
                            </span>
                        </a>

                        <div class="card-body d-flex flex-column p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold" style="font-size: 0.72rem;">
                                    Hệ @(string.IsNullOrWhiteSpace(item.ElementType) ? "Phổ thông" : item.ElementType)
                                </span>
                                <span class="small text-muted fw-semibold">⚡ @item.Power</span>
                            </div>

                            <h6 class="fw-bold text-dark mb-2 text-truncate" title="@item.Name">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"
                                   class="text-dark text-decoration-none">
                                    @item.Name
                                </a>
                            </h6>

                            <div class="mt-auto pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Giá bán:</span>
                                    <span class="fw-bold text-danger fs-5" style="font-variant-numeric: tabular-nums;">
                                        @item.Price.ToString("N0")đ
                                    </span>
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-secondary btn-sm fw-semibold flex-grow-1">
                                        Xem chi tiết
                                    </a>

                                    @if (inStock)
                                    {
                                        <form asp-controller="Cart" asp-action="Add" method="post" class="flex-grow-1 m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="btn btn-primary btn-sm fw-semibold w-100 d-inline-flex align-items-center justify-content-center gap-1">
                                                <i class="bi bi-bag-plus"></i>
                                                <span>Thêm vào giỏ hàng </span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm flex-grow-1" disabled>
                                            Tạm hết
                                        </button>
                                    }
                                </div>

                                @if (isAdmin)
                                {
                                    <div class="d-flex gap-2 mt-2 pt-2 border-top">
                                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-warning text-dark btn-sm fw-semibold flex-grow-1">
                                            <i class="bi bi-pencil-square me-1"></i>Sửa
                                        </a>
                                        <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm fw-semibold flex-grow-1">
                                            <i class="bi bi-trash3 me-1"></i>Xóa
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- 3. THANH PHÂN TRANG -->
        @if (totalPages > 1)
        {
            <nav aria-label="Phân trang thẻ bài" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-searchString="@searchString"
                           asp-route-elementType="@selectedElement"
                           asp-route-sortOrder="@sortOrder">
                            &laquo; Trước
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchString="@searchString"
                               asp-route-elementType="@selectedElement"
                               asp-route-sortOrder="@sortOrder">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-searchString="@searchString"
                           asp-route-elementType="@selectedElement"
                           asp-route-sortOrder="@sortOrder">
                            Sau &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<style>
    .tcg-filter-pill {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        transition: all 0.15s ease;
    }

        .tcg-filter-pill:hover {
            background-color: #e2e8f0;
            color: #0f172a;
        }

        .tcg-filter-pill.active {
            background-color: #0f172a;
            color: #ffffff;
            border-color: #0f172a;
        }

    .tcg-product-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .tcg-product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(15, 23, 42, 0.14) !important;
        }

    .tcg-img-stage {
        height: 245px;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px;
        overflow: hidden;
    }

    .tcg-card-photo {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        border-radius: 8px;
        transition: transform 0.25s ease;
        filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.14));
    }

    .tcg-product-card:hover .tcg-card-photo {
        transform: scale(1.05);
    }
</style>