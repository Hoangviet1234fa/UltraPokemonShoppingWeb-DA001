@model Product
@{
    ViewData["Title"] = "Thêm thẻ bài";
}

<div class="bg-white rounded-4 shadow-sm p-4 my-3">
    <h2 class="fw-bold">Thêm thẻ bài mới</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <partial name="_ProductForm" model="Model" />
                <button type="submit" class="btn btn-primary fw-semibold px-4">Lưu thẻ bài</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Quay lại</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}