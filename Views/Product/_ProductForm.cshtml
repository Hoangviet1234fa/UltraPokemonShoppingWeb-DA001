@model Product

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label fw-bold">Tên thẻ bài</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ElementType" class="form-label fw-bold">Hệ</label>
    <select asp-for="ElementType" asp-items="(SelectList)ViewBag.ElementList" class="form-select"></select>
</div>
<div class="row">
    <div class="col-6 mb-3">
        <label asp-for="Power" class="form-label fw-bold">Sức mạnh</label>
        <input asp-for="Power" class="form-control" />
    </div>
    <div class="col-6 mb-3">
        <label asp-for="Price" class="form-label fw-bold">Giá (VNĐ)</label>
        <input asp-for="Price" class="form-control" />
    </div>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label fw-bold">Mô tả</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
</div>
<div class="mb-3">
    <label class="form-label fw-bold">Ảnh thẻ bài (png, jpg, webp, gif - tối đa 5 MB)</label>
    <input type="file" name="imageFile" class="form-control" accept="image/*" />
    <span class="text-danger field-validation-error">@Html.ValidationMessage("imageFile")</span>
</div>
