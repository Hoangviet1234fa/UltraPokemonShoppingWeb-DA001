@model UltraPokemon.Models.Product

<div class="mb-3">
    <label asp-for="Name" class="form-label fw-bold">Tên thẻ bài <span class="text-danger">*</span></label>
    <input asp-for="Name" class="form-control" placeholder="Ví dụ: Charizard VMAX..." />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="ElementType" class="form-label fw-bold">Hệ nguyên tố <span class="text-danger">*</span></label>
        <!-- [ĐÃ FIX] Dùng Dropdown chọn hệ từ bảng Categories để tránh nhập sai tên hệ -->
        <select asp-for="ElementType" asp-items="ViewBag.ElementList" class="form-select">
            <option value="">-- Chọn hệ nguyên tố --</option>
        </select>
        <span asp-validation-for="ElementType" class="text-danger small"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Power" class="form-label fw-bold">Sức mạnh (HP / Power)</label>
        <input asp-for="Power" type="number" min="0" class="form-control" placeholder="Ví dụ: 120" />
        <span asp-validation-for="Power" class="text-danger small"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
        <input asp-for="Price" type="number" min="0" step="1000" class="form-control" placeholder="Ví dụ: 50000" />
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Stock" class="form-label fw-bold text-success">Số lượng tồn kho</label>
        <input asp-for="Stock" type="number" min="0" class="form-control border-success bg-light" placeholder="Số lượng lá bài có sẵn..." />
        <span asp-validation-for="Stock" class="text-danger small fw-bold"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label fw-bold">Mô tả thẻ bài</label>
    <textarea asp-for="Description" rows="3" class="form-control" placeholder="Thông tin chi tiết về kỹ năng, độ hiếm của thẻ..."></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label class="form-label fw-bold">Tải ảnh thẻ bài từ máy tính</label>
    <input type="file" name="imageFile" accept=".png,.jpg,.jpeg,.webp,.gif" class="form-control" />
    @if (ViewData.ModelState["imageFile"]?.Errors.Count > 0)
    {
        <span class="text-danger small">@ViewData.ModelState["imageFile"]!.Errors[0].ErrorMessage</span>
    }
</div>

<div class="mb-4">
    <label asp-for="ImageUrl" class="form-label fw-bold">Hoặc nhập đường dẫn ảnh (URL)</label>
    <input asp-for="ImageUrl" class="form-control" placeholder="/images/Charizard.jpeg" />
    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
</div>