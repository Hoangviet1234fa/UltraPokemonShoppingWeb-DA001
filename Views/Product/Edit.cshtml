@model Product
@{
    ViewData["Title"] = "Sửa thẻ bài";
}

<div class="bg-white rounded-4 shadow-sm p-4 my-3">
    <h2 class="fw-bold">Sửa thông tin thẻ bài</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <partial name="_ProductForm" model="Model" />
                <button type="submit" class="btn btn-primary fw-semibold px-4">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Quay lại</a>
            </form>
        </div>
        <div class="col-md-4 text-center">
            <p class="fw-bold">Ảnh hiện tại</p>
            <img src="@ImageHelper.Resolve(Env, Model)" alt="@Model.Name" class="img-fluid rounded shadow" style="max-height:300px" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}