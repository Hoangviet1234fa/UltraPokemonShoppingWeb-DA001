@model Product
@{
    ViewData["Title"] = "Xóa thẻ bài";
}

<div class="bg-white rounded-4 shadow-sm p-4 my-3">
    <h2 class="fw-bold text-danger">Xóa thẻ bài</h2>
    <h5>Bạn có chắc chắn muốn xóa thẻ bài này không?</h5>
    <hr />
    <div class="row">
        <div class="col-md-3">
            <img src="@ImageHelper.Resolve(Env, Model)" alt="@Model.Name" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-3">Tên</dt>
                <dd class="col-sm-9 fw-bold">@Model.Name</dd>
                <dt class="col-sm-3">Hệ</dt>
                <dd class="col-sm-9">@Model.ElementType</dd>
                <dt class="col-sm-3">Giá</dt>
                <dd class="col-sm-9 text-danger fw-bold">@Model.Price.ToString("N0") VNĐ</dd>
            </dl>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Quay lại</a>
            </form>
        </div>
    </div>
</div>