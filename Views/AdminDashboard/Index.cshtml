@model UltraPokemon.Models.AdminDashboardViewModel
@using System.Text.Json
@using UltraPokemon.Models
@{
    ViewData["Title"] = "Bảng điều khiển quản trị";

    // Chuyển đổi danh sách C# sang chuỗi JSON an toàn để truyền vào thư viện Chart.js
    var monthLabelsJson = Html.Raw(JsonSerializer.Serialize(Model.MonthLabels));
    var monthlyRevenuesJson = Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenues));
    var statusCountsJson = Html.Raw(JsonSerializer.Serialize(new[]
    {
        Model.CountPending,
        Model.CountShipping,
        Model.CountCompleted,
        Model.CountCancelled
    }));
}

<!-- Nhúng thư viện Bootstrap Icons (Icon vector nét mảnh đồng bộ với Bootstrap 5) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="container py-4">

    <!-- HEADER BẢNG ĐIỀU KHIỂN -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 p-4 rounded-4 text-white shadow-sm"
         style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);">
        <div>
            <span class="badge bg-warning text-dark fw-bold mb-2">ADMIN ANALYTICS</span>
            <h2 class="fw-bold mb-1">Bảng điều khiển quản trị</h2>
            <p class="text-white-50 small mb-0">
                Tổng quan doanh thu, tình trạng đơn hàng và tồn kho hệ thống Ultra Pokemon TCG
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="AdminOrders" asp-action="Index" class="btn btn-light fw-semibold px-3 d-inline-flex align-items-center gap-2">
                <i class="bi bi-bag-check"></i>
                <span>Quản lý đơn hàng</span>
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light fw-semibold px-3 d-inline-flex align-items-center gap-2">
                <i class="bi bi-grid"></i>
                <span>Kho thẻ bài</span>
            </a>
        </div>
    </div>

    <!-- PHẦN 1: 6 THẺ CHỈ SỐ TỔNG QUAN (KPI CARDS) -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Tổng đơn hàng -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Tổng đơn hàng</span>
                        <h2 class="fw-bold text-dark my-1">@Model.TotalOrders</h2>
                        <span class="small text-secondary">Bao gồm tất cả trạng thái</span>
                    </div>
                    <div class="kpi-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Sản phẩm & Tồn kho -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Mẫu thẻ & Tồn kho</span>
                        <h2 class="fw-bold text-dark my-1">@Model.TotalProducts <span class="fs-6 fw-normal text-muted">mẫu</span></h2>
                        <span class="small @(Model.LowStockProducts > 0 ? "text-danger fw-semibold" : "text-success")">
                            Còn @Model.TotalStock lá (@Model.LowStockProducts mẫu sắp hết)
                        </span>
                    </div>
                    <div class="kpi-icon bg-info bg-opacity-10 text-info">
                        <i class="bi bi-layers"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Tổng khách hàng -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Tổng khách hàng</span>
                        <h2 class="fw-bold text-dark my-1">@Model.TotalCustomers</h2>
                        <span class="small text-secondary">Tài khoản thành viên hoạt động</span>
                    </div>
                    <div class="kpi-icon bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Tổng doanh thu (Thẻ tối màu nổi bật làm điểm nhấn chính) -->
        <div class="col-md-4">
            <div class="card border-0 shadow rounded-4 h-100 text-white kpi-card"
                 style="background: linear-gradient(135deg, #111827 0%, #1f2937 100%);">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-white-50 small fw-semibold text-uppercase">Tổng doanh thu (Hợp lệ)</span>
                        <h2 class="fw-bold text-warning my-1">@Model.TotalRevenue.ToString("N0")đ</h2>
                        <span class="small text-white-50">Không tính các đơn đã hủy</span>
                    </div>
                    <div class="kpi-icon bg-warning bg-opacity-25 text-warning">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 5: Doanh thu thực nhận (Đơn đã hoàn thành) -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Doanh thu hoàn thành</span>
                        <h2 class="fw-bold text-success my-1">@Model.CompletedRevenue.ToString("N0")đ</h2>
                        <span class="small text-success">Từ @Model.CountCompleted đơn giao thành công</span>
                    </div>
                    <div class="kpi-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 6: Đơn chờ duyệt -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Đơn chờ xác nhận</span>
                        <h2 class="fw-bold text-danger my-1">@Model.PendingOrders</h2>
                        @* [ĐÃ FIX] Đổi asp-route-status="0" thành "Pending" để dropdown lọc hiển thị đúng trạng thái *@
                        <a asp-controller="AdminOrders" asp-action="Index" asp-route-status="Pending"
                           class="small text-decoration-none fw-semibold">
                            Xử lý ngay <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                    <div class="kpi-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PHẦN 2: BIỂU ĐỒ TRỰC QUAN (DOANH THU 12 THÁNG & TRẠNG THÁI ĐƠN HÀNG) -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ cột: Doanh thu 12 tháng gần nhất -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-bar-chart-line text-primary"></i>
                            <span>Doanh thu 12 tháng gần nhất</span>
                        </h5>
                        <span class="text-muted small">Đơn vị tính: VNĐ (Chỉ tính các đơn không bị hủy)</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div style="height: 310px;">
                        <canvas id="revenueBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ tròn vành khuyên: Tỷ lệ trạng thái đơn hàng -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="bi bi-pie-chart text-primary"></i>
                        <span>Trạng thái đơn hàng</span>
                    </h5>
                    <span class="text-muted small">Phân bổ tỷ lệ đơn theo tiến độ xử lý</span>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center">
                    <div style="height: 230px; width: 100%;">
                        <canvas id="statusDoughnutChart"></canvas>
                    </div>
                    <div class="w-100 mt-3 pt-2 border-top d-flex justify-content-around small text-center">
                        <div><strong class="text-warning">@Model.CountPending</strong><br><span class="text-muted">Chờ duyệt</span></div>
                        <div><strong class="text-info">@Model.CountShipping</strong><br><span class="text-muted">Đang giao</span></div>
                        <div><strong class="text-success">@Model.CountCompleted</strong><br><span class="text-muted">Hoàn thành</span></div>
                        <div><strong class="text-danger">@Model.CountCancelled</strong><br><span class="text-muted">Đã hủy</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PHẦN 3: THỐNG KÊ CỔNG THANH TOÁN & 5 ĐƠN HÀNG MỚI NHẤT -->
    <div class="row g-4">
        <!-- Cột trái: Thống kê doanh thu theo cổng thanh toán -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card text-primary"></i>
                        <span>Theo cổng thanh toán</span>
                    </h5>
                    <span class="text-muted small">Tỷ trọng giao dịch qua các phương thức</span>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (!Model.PaymentStats.Any())
                    {
                        <p class="text-muted small text-center py-4">Chưa có dữ liệu giao dịch.</p>
                    }
                    else
                    {
                        foreach (var stat in Model.PaymentStats)
                        {
                            decimal percent = Model.TotalRevenue > 0
                                ? Math.Round((stat.TotalAmount / Model.TotalRevenue) * 100, 1)
                                : 0;

                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-bold text-dark">@stat.MethodName (@stat.OrderCount đơn)</span>
                                    <span class="fw-bold text-primary">@stat.TotalAmount.ToString("N0")đ</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @percent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: 5 đơn hàng mới đặt gần đây -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-clock text-primary"></i>
                            <span>Đơn hàng mới nhất</span>
                        </h5>
                        <span class="text-muted small">5 giao dịch phát sinh gần đây nhất</span>
                    </div>
                    <a asp-controller="AdminOrders" asp-action="Index" class="btn btn-sm btn-outline-primary fw-semibold">
                        Xem tất cả
                    </a>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Khách hàng</th>
                                    <th>Thanh toán</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RecentOrders.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Chưa có đơn hàng nào.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var order in Model.RecentOrders)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">@order.OrderCode</td>
                                            <td>
                                                <div class="fw-semibold small">@order.FullName</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@order.PaymentMethod</span></td>
                                            <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0")đ</td>
                                            <td>
                                                @switch (order.Status)
                                                {
                                                    case OrderStatus.Pending:
                                                        <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                                        break;
                                                    case OrderStatus.Shipping:
                                                        <span class="badge bg-info text-dark">Đang giao</span>
                                                        break;
                                                    case OrderStatus.Completed:
                                                        <span class="badge bg-success">Hoàn thành</span>
                                                        break;
                                                    case OrderStatus.Cancelled:
                                                        <span class="badge bg-danger">Đã hủy</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@order.Id"
                                                   class="btn btn-sm btn-outline-secondary">Xem</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .kpi-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.09) !important;
        }

    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }
</style>

@section Scripts {
    <!-- Nhúng thư viện Chart.js từ CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const monthLabels = @monthLabelsJson;
            const monthlyRevenues = @monthlyRevenuesJson;
            const statusCounts = @statusCountsJson;

            // 1. Vẽ Biểu đồ cột (Bar Chart) - Doanh thu 12 tháng
            const ctxBar = document.getElementById('revenueBarChart').getContext('2d');
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: monthLabels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: monthlyRevenues,
                        backgroundColor: 'rgba(30, 58, 138, 0.85)',
                        hoverBackgroundColor: '#1d4ed8',
                        borderRadius: 6,
                        maxBarThickness: 38
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return ' ' + Number(context.raw).toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    return Number(value).toLocaleString('vi-VN') + 'đ';
                                }
                            },
                            grid: { color: 'rgba(0, 0, 0, 0.05)' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });

            // 2. Vẽ Biểu đồ tròn vành khuyên (Doughnut Chart) - Trạng thái đơn hàng
            const ctxDoughnut = document.getElementById('statusDoughnutChart').getContext('2d');
            new Chart(ctxDoughnut, {
                type: 'doughnut',
                data: {
                    labels: ['Chờ duyệt', 'Đang giao', 'Hoàn thành', 'Đã hủy'],
                    datasets: [{
                        data: statusCounts,
                        backgroundColor: [
                            '#ffc107', // Chờ duyệt (Vàng)
                            '#0dcaf0', // Đang giao (Xanh dương nhạt)
                            '#198754', // Hoàn thành (Xanh lá)
                            '#dc3545'  // Đã hủy (Đỏ)
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 14,
                                font: { size: 12 }
                            }
                        }
                    }
                }
            });
        });
    </script>
}