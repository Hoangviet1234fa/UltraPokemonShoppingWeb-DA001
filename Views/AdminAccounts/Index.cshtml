@model IEnumerable<UltraPokemon.Models.User>

@{
    // Gán tiêu đề cho trang
    ViewData["Title"] = "Quản lý tài khoản";
    var currentSearch = Context.Request.Query["search"].ToString();
    var currentRole = Context.Request.Query["role"].ToString();
}

<div class="bg-white rounded-3 border p-4 mb-4 shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h3 class="fw-bold text-dark mb-0">
            <i class="bi bi-people-fill text-primary me-2"></i>Quản lý tài khoản người dùng (Admin Panel)
        </h3>
        <a asp-action="Create" class="btn btn-success fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i>Thêm tài khoản
        </a>
    </div>    <hr />

    <!-- Hiển thị thông báo thành công hoặc lỗi nếu có -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thanh tìm kiếm và lọc theo Role -->
    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Tìm theo họ tên hoặc email..." />
        </div>
        <div class="col-md-3">
            <select name="role" class="form-select">
                <option value="">-- Tất cả quyền hạn --</option>
                <option value="Admin" selected="@(currentRole == "Admin")">Admin</option>
                <option value="Staff" selected="@(currentRole == "Staff")">Staff</option>
                <option value="Customer" selected="@(currentRole == "Customer")">Customer</option>
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Tìm / Lọc
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle shadow-sm">
            <thead class="table-dark text-center">
                <tr>
                    <th style="width: 5%">ID</th>
                    <th>Email</th>
                    <th style="width: 14%">Quyền hạn (Role)</th>
                    <th style="width: 15%">Trạng thái</th>
                    <th style="width: 24%">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="text-center">
                        <td>@u.Id</td>
                        <td class="text-start fw-bold">@u.Email</td>
                        <td>
                            <!-- Đổi màu huy hiệu (Badge) tự động theo Role -->
                            <span class="badge bg-@(u.Role == "Admin" ? "danger" : (u.Role == "Staff" ? "warning text-dark" : "primary"))">@u.Role</span>
                        </td>
                        <td>
                            <span class="badge bg-@(u.IsApproved ? "success" : "secondary")">
                                @(u.IsApproved ? "Hoạt động" : "Đang bị khóa")
                            </span>
                        </td>
                        <td>
                            @* [ĐÃ FIX] Khớp email Admin gốc admin@ultrapokemon.vn từ Program.cs *@
                            @if (u.Email != User.Identity?.Name && u.Email != "admin@ultrapokemon.vn")
                            {
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-primary btn-sm">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>

                                <form asp-action="ToggleLock" asp-route-id="@u.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-@(u.IsApproved ? "warning" : "success") btn-sm">
                                        <i class="bi bi-@(u.IsApproved ? "lock" : "unlock")"></i> @(u.IsApproved ? "Khóa" : "Mở khóa")
                                    </button>
                                </form>

                                <!-- BẮT BUỘC SỬ DỤNG FORM ĐỂ GỬI YÊU CẦU POST KÈM ANTIFORGERY TOKEN -->
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản @u.Email không?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            }
                            else
                            {
                                <!-- Không cho phép tự xóa/khóa chính mình hoặc tài khoản Admin gốc -->
                                <span class="text-muted small"><em>Tài khoản hệ thống</em></span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>