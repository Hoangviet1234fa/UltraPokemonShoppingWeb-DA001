@model UltraPokemon.Models.User

@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách tài khoản
        </a>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-primary text-white py-3 rounded-top-4">
                <h5 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa tài khoản #@Model.Id</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email đăng nhập <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Đặt lại mật khẩu mới <span class="text-muted fw-normal">(Bỏ trống nếu giữ nguyên)</span></label>
                        <input type="password" name="newPassword" class="form-control" placeholder="Nhập mật khẩu mới nếu muốn đổi..." />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-bold">Vai trò phân quyền</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Admin">Quản trị viên (Admin)</option>
                            <option value="Staff">Nhân viên (Staff)</option>
                            <option value="Customer">Khách hàng (Customer)</option>
                        </select>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsApproved" class="form-check-input" type="checkbox" />
                        <label asp-for="IsApproved" class="form-check-label fw-semibold">Tài khoản đã được phê duyệt hoạt động</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill">
                        <i class="bi bi-save me-1"></i> Cập nhật tài khoản
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}