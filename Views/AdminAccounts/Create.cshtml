@model UltraPokemon.Models.User

@{
    ViewData["Title"] = "Tạo tài khoản mới";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách tài khoản
        </a>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-dark text-white py-3 rounded-top-4">
                <h5 class="fw-bold mb-0"><i class="bi bi-person-plus-fill me-2"></i>Tạo tài khoản mới</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên..." required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email đăng nhập <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="example@ultrapokemon..vn" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu <span class="text-danger">*</span></label>
                        <input type="password" name="rawPassword" class="form-control" placeholder="Tối thiểu 6 ký tự..." required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-bold">Vai trò phân quyền</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Admin">Quản trị viên (Admin)</option>
                            <option value="Staff" selected>Nhân viên (Staff)</option>
                            <option value="Customer">Khách hàng (Customer)</option>
                        </select>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsApproved" class="form-check-input" type="checkbox" checked />
                        <label asp-for="IsApproved" class="form-check-label fw-semibold">Kích hoạt / Phê duyệt ngay</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill">
                        <i class="bi bi-check-circle me-1"></i> Lưu tài khoản
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}