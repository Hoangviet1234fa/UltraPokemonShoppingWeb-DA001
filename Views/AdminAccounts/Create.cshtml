@model UltraPokemon.Models.User

@{
    ViewData["Title"] = "Thêm tài khoản mới";
}

<div class="row justify-content-center py-3">
    <div class="col-md-8 col-lg-6">
        <div class="bg-white rounded-3 border shadow-sm overflow-hidden">
            <!-- Header khung form -->
            <div class="px-4 py-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-person-plus-fill text-success me-2"></i>Thêm tài khoản mới
                </h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    &larr; Quay lại
                </a>
            </div>

            <!-- Nội dung form -->
            <div class="p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3"></div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text"
                               name="FullName"
                               value="@Model?.FullName"
                               class="form-control"
                               placeholder="Nhập họ và tên người dùng..."
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Email đăng nhập <span class="text-danger">*</span></label>
                        <input type="email"
                               name="Email"
                               value="@Model?.Email"
                               class="form-control"
                               placeholder="Ví dụ: nhanvien@ultrapokemon.vn"
                               required />
                        <div class="form-text">Email bắt buộc sử dụng tên miền kết thúc bằng <strong>.vn</strong> theo quy chuẩn hệ thống.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                        <input type="password"
                               name="rawPassword"
                               class="form-control"
                               minlength="6"
                               placeholder="Tối thiểu 6 ký tự..."
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Quyền hạn (Role) <span class="text-danger">*</span></label>
                        <select name="Role" class="form-select">
                            <option value="Customer" selected="@(Model?.Role == "Customer")">Customer — Khách hàng</option>
                            <option value="Staff" selected="@(Model?.Role == "Staff")">Staff — Nhân viên kho</option>
                            <option value="Admin" selected="@(Model?.Role == "Admin")">Admin — Quản trị viên</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="IsApproved"
                                   name="IsApproved"
                                   value="true"
                                   checked="@(Model?.IsApproved ?? true)" />
                            <input type="hidden" name="IsApproved" value="false" />
                            <label class="form-check-label fw-medium text-dark" for="IsApproved">
                                Kích hoạt tài khoản ngay (Hoạt động)
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-success fw-semibold px-4">
                            <i class="bi bi-check-lg me-1"></i>Tạo tài khoản
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>